{
  "name": "Harmony Dev",
  "build": { "dockerfile": "Dockerfile" },

  // P5b 構成 (#1122 比較用): features 残り 3 つ (github-cli / claude-code / copilot-cli) は
  // base/Dockerfile に inline 化したまま、docker-outside-of-docker のみ削除。
  // publish-dev-image は host bash で実行する運用 (container 内に docker CLI 無し)。
  // 結果: SELinux 緩和の runArgs / docker.sock mount / postStartCommand すべて不要、
  //       image size -~220 MB、複雑度減。

  "forwardPorts": [5173, 5179],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "notify" },
    "5179": { "label": "Backend (MCP + WS)", "onAutoForward": "silent" }
  },

  "mounts": [
    "source=${localEnv:HOME}/.agent-containers/${localWorkspaceFolderBasename}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.agent-containers/${localWorkspaceFolderBasename}/.codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.agent-containers/${localWorkspaceFolderBasename}/.copilot,target=/home/node/.copilot,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.agent-containers/${localWorkspaceFolderBasename}/.harmony,target=/home/node/.harmony,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,consistency=cached",
    // ~/.gitconfig は optional な host 設定であり、AI / gh の永続化ディレクトリとは性質が異なる (#1417)。
    // 空ファイルを touch して bind mount すると Dev Containers の git config copy 段階と二重処理になり
    // "unexpected end of parent stream" で起動失敗することがあるため explicit bind mount しない。
    // git identity は repo local config か、container 内 `git config --global` で必要な人だけ設定する。
    // WSLg (Windows + WSL2 + Docker Desktop 前提): on-demand headed browser は X11 経由で表示する。
    // WAYLAND_DISPLAY / XDG_RUNTIME_DIR は設定しない。Dev Containers 拡張の Wayland socket
    // 自動 mount は repo から強制停止できないため、/run/user/<uid>/wayland-0 の bind mount
    // エラーが出る環境では VS Code user settings で dev.containers.mountWaylandSocket=false を設定する。 #1451
    // 他 OS (macOS / Linux native) ではこの mount を当該行 comment out 推奨。
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind,consistency=cached"
  ],

  // initializeCommand: container 起動「前」に host 側 bind mount source path を事前作成。
  // Dev Containers は内部的に docker `--mount type=bind` を使い、`-v` と違い missing
  // source は自動作成されない (`-v` は legacy 仕様で auto-create するが `--mount` は error)。
  // host shell = bash 前提 (WSL2 / macOS / Linux); 既存 dir / file は no-op。 #1340
  // ~/.gitconfig は optional なので touch しない (#1417)。AI / gh の永続化 dir のみ事前作成する。
  "initializeCommand": "bash -c 'mkdir -p ~/.agent-containers/${localWorkspaceFolderBasename}/{.claude,.codex,.copilot,.harmony} ~/.config/gh'",

  "onCreateCommand": "sudo chown -R node:node /home/node/.claude /home/node/.codex /home/node/.copilot /home/node/.harmony /home/node/.config/gh",

  // PR #1378 (#1375) で npm workspaces 化。root 1 回の `npm install` で
  // shared / frontend / backend を一括解決し、shared/package.json の `prepare`
  // hook で `shared/dist/` を build する。subdir 単独 install
  // (`npm install --prefix frontend`) は workspace 認識されず @harmony/shared の
  // registry lookup で 404 fail するため不可。 #1383
  "postCreateCommand": "npm install && ([ -f ~/.claude/.config.json ] || echo '{}' > ~/.claude/.config.json)",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": false,
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "node",

  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/node/.cache/ms-playwright",
    // タイムゾーン (harmony は日本向けプロダクト、log/date を JST 表示)
    "TZ": "Asia/Tokyo",
    // WSLg 経由 headed browser 用 (Windows + WSL2 + Docker Desktop)。
    // Wayland env は設定せず、headed browser は X11 fallback に寄せる。
    // headless mode 時は無視される、他 OS では設定値そのまま入るが mount なしのため使われない。
    "DISPLAY": ":0"
  }
}
