# Copy this file to .env when you want to override the compose defaults.

# Image to run. Maintainers can build this tag locally with:
#   bash scripts/build-harmony-image.sh local
HARMONY_IMAGE=ghcr.io/csilost2001/harmony:local

# Host-only port. Open http://127.0.0.1:${HARMONY_PORT}/ after startup.
HARMONY_PORT=5179

# Host directory mounted as /data/workspaces inside the container.
HARMONY_WORKSPACES=./workspaces

# Podman on SELinux hosts may need:
#   HARMONY_WORKSPACES_MOUNT_OPTIONS=:Z
HARMONY_WORKSPACES_MOUNT_OPTIONS=
