{
  "name": "harmony-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Harnize Harmony — AI 協業前提の業務システム設計ツール (frontend + backend + shared)",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "scripts": {
    "install:all": "npm install",
    "dev": "node scripts/dev-deprecated.mjs",
    "restart": "node scripts/dev-deprecated.mjs",
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "kill": "node scripts/kill-ports.mjs",
    "restart:backend": "node scripts/kill-ports.mjs --port 5179 && npm run backend",
    "restart:frontend": "node scripts/kill-ports.mjs --port 5173 && npm run frontend",
    "build": "npm run build --workspace=@harmony/shared && concurrently -n frontend,backend -c cyan,magenta \"npm --prefix frontend run build\" \"npm --prefix backend run build\"",
    "test:unit": "npm --prefix frontend run test:unit",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:regression:json": "npm --prefix frontend run test:e2e:regression -- --reporter=json",
    "test:spec-check": "node scripts/spec-check/test.mjs && node scripts/spec-check/test-binding-grammar.mjs",
    "test:verify": "node scripts/verify/test.mjs",
    "verify:regression-trace": "node scripts/verify/regression-trace-check.mjs",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "npm --prefix backend test",
    "verify:colors": "node scripts/verify/no-raw-colors.mjs",
    "verify:classes": "node scripts/verify/no-undefined-bootstrap-classes.mjs",
    "check": "node scripts/verify/check.mjs",
    "ui:shots": "node scripts/dev/ui-shots.mjs",
    "ui:audit": "node scripts/dev/theme-audit.mjs",
    "ui:narrow": "node scripts/dev/narrow-audit.mjs",
    "export:doc": "node scripts/export-design-doc.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:deps": "node scripts/dev/deps-report.mjs",
    "check:generation": "tsx scripts/dev/check-generation.mts",
    "eval:design": "tsx scripts/dev/eval-design.mts",
    "mcp:report": "node scripts/dev/mcp-usage-report.mjs",
    "ai:feedback": "tsx scripts/dev/ai-feedback.mts",
    "check:docs": "node scripts/verify/docs-freshness.mjs",
    "docs:shots": "node scripts/dev/docs-shots.mjs",
    "coverage": "node scripts/verify/changed-coverage.mjs --all",
    "coverage:changed": "node scripts/verify/changed-coverage.mjs",
    "e2e:report": "node scripts/verify/e2e-report.mjs",
    "migrate:schema": "tsx scripts/migrate-schema.mts",
    "export:tests": "node scripts/export-test-viewpoints.mjs",
    "export:seed": "node scripts/export-seed-data.mjs",
    "setup": "node scripts/setup.mjs",
    "release:notes": "node scripts/release/notes.mjs"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.0.0",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
