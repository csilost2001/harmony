{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "profile-settings",
  "uuid": "0ede272d-a094-4651-b37e-b6f3747c4248",
  "name": "プロフィール/設定",
  "description": "プロフィール確認・学習設定変更画面 (補助)。ユーザー情報 (表示名 / メール) と学習設定 (目標 CEFR レベル) を表示・編集できる。",
  "kind": "form",
  "path": "/profile",
  "auth": "required",
  "groupId": "learner",
  "maturity": "draft",
  "createdAt": "2026-05-04T00:00:00.000Z",
  "updatedAt": "2026-05-04T00:00:00.000Z",
  "items": [
    {
      "id": "displayName",
      "label": "表示名",
      "type": "string",
      "direction": "in",
      "required": true,
      "maxLength": 50,
      "description": "users.display_name の編集フィールド。",
      "binding": {
        "kind": "tableColumn",
        "ref": {
          "tableId": "user",
          "columnId": "col-display-name"
        }
      }
    },
    {
      "id": "email",
      "label": "メールアドレス",
      "type": "string",
      "direction": "out",
      "description": "users.email の読み取り専用表示。変更は別途メール確認フローが必要なため読み取り専用とする。",
      "binding": {
        "kind": "tableColumn",
        "ref": {
          "tableId": "user",
          "columnId": "col-email"
        }
      }
    },
    {
      "id": "cefrLevelDisplay",
      "label": "現在の CEFR レベル",
      "type": "string",
      "direction": "out",
      "description": "users.cefr_level の読み取り専用表示。自動昇格のため手動変更不可。",
      "binding": {
        "kind": "tableColumn",
        "ref": {
          "tableId": "user",
          "columnId": "col-cefr-level"
        }
      }
    },
    {
      "id": "targetCefrLevel",
      "label": "目標 CEFR レベル",
      "type": "string",
      "direction": "in",
      "required": false,
      "options": [
        {
          "value": "A1",
          "label": "A1 入門"
        },
        {
          "value": "A2",
          "label": "A2 初級"
        },
        {
          "value": "B1",
          "label": "B1 中級"
        },
        {
          "value": "B2",
          "label": "B2 中上級"
        },
        {
          "value": "C1",
          "label": "C1 上級"
        },
        {
          "value": "C2",
          "label": "C2 最上級"
        }
      ],
      "description": "users.target_cefr_level の編集フィールド。プロフィール設定画面で変更可能。",
      "binding": {
        "kind": "tableColumn",
        "ref": {
          "tableId": "user",
          "columnId": "col-target-cefr-level"
        }
      }
    },
    {
      "id": "interests",
      "label": "興味分野",
      "type": "json",
      "direction": "in",
      "description": "users.interests の編集フィールド (JSON 配列)。IT / ビジネス / 旅行等の興味分野を複数選択。コンテンツパック選択のレコメンドに使用する。",
      "binding": {
        "kind": "tableColumn",
        "ref": {
          "tableId": "user",
          "columnId": "col-interests"
        }
      }
    },
    {
      "id": "saveProfile",
      "label": "設定を保存する",
      "type": "string",
      "direction": "in",
      "description": "送信ボタン。users テーブルの display_name / target_cefr_level / interests を更新する処理フローを実行する。"
    }
  ],
  "design": {
    "designFileRef": "profile-settings.design.json"
  }
}
