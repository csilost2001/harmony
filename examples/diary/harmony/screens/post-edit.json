{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "post-edit",
  "uuid": "531619ae-0f5f-4f55-8043-03e5a9ef6670",
  "name": "投稿編集",
  "description": "Notion + Substack 風の投稿作成・編集フォーム画面。タイトル入力・Markdownエディタ・写真D&Dアップロード・AI assistサイドパネル (要約/タグ提案/校正/画像alt)・mood/weather/locationフィールド・保存ボタン (sticky bottom)。path :id? の有無で新規作成 / 更新モードを切り替え。saveButton.events に create/update 双方を結線し、UI 側で URL parameter から実行 event を選ぶ実装を想定。",
  "kind": "form",
  "path": "/post/edit/:id?",
  "auth": "required",
  "maturity": "draft",
  "createdAt": "2026-05-06T14:30:00.000Z",
  "updatedAt": "2026-05-07T00:00:00.000Z",
  "items": [
    {
      "id": "postTitle",
      "label": "タイトル",
      "type": "string",
      "direction": "in",
      "description": "投稿のタイトル。",
      "required": true,
      "maxLength": 200,
      "placeholder": "タイトルを入力…"
    },
    {
      "id": "postBody",
      "label": "本文",
      "type": "string",
      "direction": "in",
      "description": "投稿本文 (Markdown形式)。Markdownエディタ + プレビュー切り替え。",
      "required": true,
      "placeholder": "今日のことを書いてみましょう…"
    },
    {
      "id": "mood",
      "label": "気分",
      "type": "string",
      "direction": "in",
      "description": "投稿時の気分を表す絵文字。",
      "options": [
        {
          "value": "happy",
          "label": "😊 嬉しい"
        },
        {
          "value": "excited",
          "label": "🤩 興奮"
        },
        {
          "value": "calm",
          "label": "😌 穏やか"
        },
        {
          "value": "sad",
          "label": "😢 悲しい"
        },
        {
          "value": "tired",
          "label": "😴 疲れた"
        },
        {
          "value": "angry",
          "label": "😤 怒り"
        },
        {
          "value": "anxious",
          "label": "😰 不安"
        },
        {
          "value": "grateful",
          "label": "🙏 感謝"
        }
      ],
      "required": false
    },
    {
      "id": "weather",
      "label": "天気",
      "type": "string",
      "direction": "in",
      "description": "投稿時の天気を表す絵文字。",
      "options": [
        {
          "value": "sunny",
          "label": "☀️ 晴れ"
        },
        {
          "value": "cloudy",
          "label": "☁️ 曇り"
        },
        {
          "value": "rainy",
          "label": "🌧️ 雨"
        },
        {
          "value": "snowy",
          "label": "❄️ 雪"
        },
        {
          "value": "partly_cloudy",
          "label": "⛅ 晴れのち曇り"
        },
        {
          "value": "stormy",
          "label": "⛈️ 嵐"
        }
      ],
      "required": false
    },
    {
      "id": "location",
      "label": "場所",
      "type": "string",
      "direction": "in",
      "description": "投稿に記録する場所名。フリーテキスト入力。",
      "maxLength": 100,
      "placeholder": "場所を入力 (例: 東京・渋谷)",
      "required": false
    },
    {
      "id": "tagIds",
      "label": "タグ",
      "type": {
        "kind": "array",
        "itemType": "integer"
      },
      "direction": "in",
      "description": "投稿に付与するタグのID配列。タグ候補一覧からマルチセレクト。",
      "required": false
    },
    {
      "id": "photos",
      "label": "写真",
      "type": {
        "kind": "array",
        "itemType": {
          "kind": "object",
          "fields": [
            {
              "name": "id",
              "type": "integer"
            },
            {
              "name": "postId",
              "type": "integer"
            },
            {
              "name": "url",
              "type": "string",
              "required": true
            },
            {
              "name": "thumbnailUrl",
              "type": "string"
            },
            {
              "name": "alt",
              "type": "string"
            },
            {
              "name": "caption",
              "type": "string"
            },
            {
              "name": "orderIndex",
              "type": "integer"
            },
            {
              "name": "width",
              "type": "integer"
            },
            {
              "name": "height",
              "type": "integer"
            },
            {
              "name": "bytes",
              "type": "integer"
            },
            {
              "name": "mimeType",
              "type": "string"
            },
            {
              "name": "exifJson",
              "type": "json"
            }
          ]
        }
      },
      "direction": "in",
      "description": "添付写真ファイル一覧。D&Dまたはクリックでアップロード。AI画像alt生成フローに渡すことができる。",
      "required": false
    },
    {
      "id": "status",
      "label": "公開状態",
      "type": "string",
      "direction": "in",
      "description": "投稿の公開状態。published=公開 / draft=下書き。",
      "options": [
        {
          "value": "published",
          "label": "公開"
        },
        {
          "value": "draft",
          "label": "下書き"
        }
      ],
      "defaultValue": "draft",
      "required": true
    },
    {
      "id": "aiSummary",
      "label": "AI要約",
      "type": "string",
      "direction": "out",
      "description": "AI要約生成フローから返却された要約テキスト。サイドパネルに表示。",
      "binding": {
        "kind": "flowVariable",
        "path": "summary",
        "processFlowId": "ai-summary-generate"
      }
    },
    {
      "id": "aiSuggestedTags",
      "label": "AIタグ提案",
      "type": {
        "kind": "array",
        "itemType": {
          "kind": "object",
          "fields": [
            {
              "name": "slug",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "confidence",
              "type": "number",
              "required": true
            },
            {
              "name": "isNew",
              "type": "boolean",
              "required": true
            }
          ]
        }
      },
      "direction": "out",
      "description": "AIタグ提案フローから返却されたタグ候補配列。サイドパネルに表示し、1クリックで適用可。",
      "binding": {
        "kind": "flowVariable",
        "path": "suggestedTags",
        "processFlowId": "ai-tag-suggest"
      }
    },
    {
      "id": "aiProofreadResult",
      "label": "AI校正結果",
      "type": "string",
      "direction": "out",
      "description": "AI文章校正フローから返却された校正済みテキストまたは指摘コメント。サイドパネルに表示。",
      "binding": {
        "kind": "flowVariable",
        "path": "proofreadResult",
        "processFlowId": "ai-text-proofread"
      }
    },
    {
      "id": "aiImageAlt",
      "label": "AI画像alt",
      "type": "string",
      "direction": "out",
      "description": "AI画像alt生成フローから返却されたalt文字列。写真カードに適用可。",
      "binding": {
        "kind": "flowVariable",
        "path": "altText",
        "processFlowId": "ai-image-alt-generate"
      }
    },
    {
      "id": "postId",
      "label": "投稿ID",
      "type": "integer",
      "direction": "out",
      "description": "URL :id? が指定されている場合の編集対象 postId。新規モードでは null。投稿詳細取得 ProcessFlow の outputs.post.postId を IdentifierPath (post.postId) で参照する。",
      "binding": {
        "kind": "flowVariable",
        "path": "post.postId",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "selectedPhotoId",
      "label": "AI alt 対象写真ID",
      "type": "integer",
      "direction": "in",
      "description": "AI画像alt生成 button 押下時に対象となる photos[] の id を保持する画面 state。photo クリック時に実装側で update する。",
      "required": false
    },
    {
      "id": "uploadPhotoFile",
      "label": "写真アップロード",
      "type": {
        "kind": "file",
        "format": "image/*"
      },
      "direction": "in",
      "description": "写真 D&D ゾーン / file picker。ファイル選択 (submit event) で 写真アップロード ProcessFlow を起動し、photos[] に追加する。",
      "required": false,
      "events": [
        {
          "id": "submit",
          "label": "写真アップロード実行",
          "handlerFlowId": "photo-upload",
          "argumentMapping": {
            "postId": "@screen.post-edit.item.postId",
            "file": "@self"
          }
        }
      ]
    },
    {
      "id": "saveButton",
      "label": "保存",
      "type": "string",
      "direction": "in",
      "description": "保存ボタン (公開 / 下書きは status item の値で決まる)。新規モード (postId=null) では 投稿作成 を、更新モード (postId 有) では 投稿更新 を起動する。UI 側で URL :id? の有無により click-create / click-update を選択する。",
      "required": false,
      "events": [
        {
          "id": "click-create",
          "label": "新規投稿作成",
          "handlerFlowId": "post-create",
          "argumentMapping": {
            "title": "@screen.post-edit.item.postTitle",
            "body": "@screen.post-edit.item.postBody",
            "mood": "@screen.post-edit.item.mood",
            "weather": "@screen.post-edit.item.weather",
            "location": "@screen.post-edit.item.location",
            "status": "@screen.post-edit.item.status",
            "photos": "@screen.post-edit.item.photos",
            "tags": "@screen.post-edit.item.tagIds"
          }
        },
        {
          "id": "click-update",
          "label": "既存投稿更新",
          "handlerFlowId": "post-update",
          "argumentMapping": {
            "postId": "@screen.post-edit.item.postId",
            "title": "@screen.post-edit.item.postTitle",
            "body": "@screen.post-edit.item.postBody",
            "mood": "@screen.post-edit.item.mood",
            "weather": "@screen.post-edit.item.weather",
            "location": "@screen.post-edit.item.location",
            "status": "@screen.post-edit.item.status",
            "photos": "@screen.post-edit.item.photos",
            "tags": "@screen.post-edit.item.tagIds"
          }
        }
      ]
    },
    {
      "id": "aiSummarizeButton",
      "label": "AI 要約",
      "type": "string",
      "direction": "in",
      "description": "AI assist サイドパネルの「要約」ボタン。クリックで AI要約生成 ProcessFlow を起動し、結果を aiSummary に表示する。",
      "required": false,
      "events": [
        {
          "id": "click",
          "label": "AI 要約実行",
          "handlerFlowId": "ai-summary-generate",
          "argumentMapping": {
            "postId": "@screen.post-edit.item.postId",
            "body": "@screen.post-edit.item.postBody"
          }
        }
      ]
    },
    {
      "id": "aiTagSuggestButton",
      "label": "AI タグ提案",
      "type": "string",
      "direction": "in",
      "description": "AI assist サイドパネルの「タグ提案」ボタン。クリックで AIタグ提案 ProcessFlow を起動し、結果を aiSuggestedTags に表示する。",
      "required": false,
      "events": [
        {
          "id": "click",
          "label": "AI タグ提案実行",
          "handlerFlowId": "ai-tag-suggest",
          "argumentMapping": {
            "title": "@screen.post-edit.item.postTitle",
            "body": "@screen.post-edit.item.postBody"
          }
        }
      ]
    },
    {
      "id": "aiProofreadButton",
      "label": "AI 校正",
      "type": "string",
      "direction": "in",
      "description": "AI assist サイドパネルの「校正」ボタン。クリックで AI文章校正 ProcessFlow を起動し、結果を aiProofreadResult に表示する。style は conventions.msg.proofreadStyle (default: 'casual-diary') を採用。",
      "required": false,
      "events": [
        {
          "id": "click",
          "label": "AI 校正実行",
          "handlerFlowId": "ai-text-proofread",
          "argumentMapping": {
            "text": "@screen.post-edit.item.postBody",
            "style": "@conv.msg.proofreadStyle"
          }
        }
      ]
    },
    {
      "id": "aiImageAltButton",
      "label": "AI 画像 alt",
      "type": "string",
      "direction": "in",
      "description": "写真カードのインライン「AI alt」ボタン。クリック時に対象 photo の id を selectedPhotoId にセットしてから AI画像alt生成 ProcessFlow を起動し、結果を aiImageAlt に表示する。",
      "required": false,
      "events": [
        {
          "id": "click",
          "label": "AI 画像 alt 実行",
          "handlerFlowId": "ai-image-alt-generate",
          "argumentMapping": {
            "photoId": "@screen.post-edit.item.selectedPhotoId"
          }
        }
      ]
    }
  ],
  "design": {
    "designFileRef": "post-edit.design.json"
  }
}
