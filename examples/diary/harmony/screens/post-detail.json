{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "post-detail",
  "uuid": "ffec74d0-6c21-45f7-a387-167ac8819255",
  "name": "投稿詳細",
  "description": "Medium 風の投稿詳細表示画面。ヒーロー画像・タイトル・メタ情報 (公開日/著者/mood/天気/場所) + Markdownレンダリング本文 + フォトギャラリー + タグチップを表示。所有者には編集/削除ボタンを表示。編集ボタンは /post/edit/:id への画面遷移 (リンク扱いのため events 結線なし)、削除ボタンは deleteConfirm.events で 投稿削除 ProcessFlow と結線。",
  "kind": "detail",
  "path": "/post/:id",
  "auth": "required",
  "maturity": "draft",
  "createdAt": "2026-05-06T14:30:00.000Z",
  "updatedAt": "2026-05-07T00:00:00.000Z",
  "items": [
    {
      "id": "postId",
      "label": "投稿ID",
      "type": "integer",
      "direction": "out",
      "description": "URL :id パラメータから取得した投稿ID。投稿詳細取得フローの outputs.post.postId を IdentifierPath (post.postId) で参照、deleteConfirm.events で 投稿削除 (postId integer) に渡す。",
      "binding": {
        "kind": "flowVariable",
        "path": "post.postId",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "postTitle",
      "label": "タイトル",
      "type": "string",
      "direction": "out",
      "description": "投稿タイトル。",
      "binding": {
        "kind": "flowVariable",
        "path": "title",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "postBody",
      "label": "本文",
      "type": "string",
      "direction": "out",
      "description": "投稿本文 (Markdown形式)。prose-lg スタイルでレンダリングする。",
      "binding": {
        "kind": "flowVariable",
        "path": "body",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "heroImageUrl",
      "label": "ヒーロー画像URL",
      "type": "string",
      "direction": "out",
      "description": "投稿のヒーロー画像URL。null の場合はグラデーション背景で代替。",
      "binding": {
        "kind": "flowVariable",
        "path": "heroImageUrl",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "publishedAt",
      "label": "公開日",
      "type": "datetime",
      "direction": "out",
      "displayFormat": "YYYY年MM月DD日",
      "description": "投稿公開日時。",
      "binding": {
        "kind": "flowVariable",
        "path": "publishedAt",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "authorName",
      "label": "著者名",
      "type": "string",
      "direction": "out",
      "description": "投稿者の表示名。",
      "binding": {
        "kind": "flowVariable",
        "path": "authorName",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "mood",
      "label": "気分",
      "type": "string",
      "direction": "out",
      "description": "投稿時の気分を表す絵文字または文字列。",
      "binding": {
        "kind": "flowVariable",
        "path": "mood",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "weather",
      "label": "天気",
      "type": "string",
      "direction": "out",
      "description": "投稿時の天気を表す絵文字または文字列。",
      "binding": {
        "kind": "flowVariable",
        "path": "weather",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "location",
      "label": "場所",
      "type": "string",
      "direction": "out",
      "description": "投稿に記録された場所名。",
      "binding": {
        "kind": "flowVariable",
        "path": "location",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "tags",
      "label": "タグ",
      "type": {
        "kind": "array",
        "itemType": {
          "kind": "object",
          "fields": [
            {
              "name": "id",
              "type": "integer",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "slug",
              "type": "string",
              "required": true
            },
            {
              "name": "color",
              "type": "string"
            }
          ]
        }
      },
      "direction": "out",
      "description": "この投稿に付与されたタグ配列 (id / name / slug / color を含む)。",
      "binding": {
        "kind": "flowVariable",
        "path": "tags",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "photos",
      "label": "フォトギャラリー",
      "type": {
        "kind": "array",
        "itemType": {
          "kind": "object",
          "fields": [
            {
              "name": "id",
              "type": "integer",
              "required": true
            },
            {
              "name": "url",
              "type": "string",
              "required": true
            },
            {
              "name": "alt",
              "type": "string"
            },
            {
              "name": "orderIndex",
              "type": "integer"
            }
          ]
        }
      },
      "direction": "out",
      "description": "この投稿に添付された写真配列 (id / url / alt / orderIndex を含む)。lightbox 対応。",
      "binding": {
        "kind": "flowVariable",
        "path": "photos",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "isOwner",
      "label": "所有者フラグ",
      "type": "boolean",
      "direction": "out",
      "description": "ログインユーザーが投稿者本人かどうか。true の場合に編集/削除ボタンを表示。",
      "binding": {
        "kind": "flowVariable",
        "path": "isOwner",
        "processFlowId": "post-detail-get"
      }
    },
    {
      "id": "deleteConfirm",
      "label": "削除実行",
      "type": "boolean",
      "direction": "in",
      "description": "削除確認ダイアログでOKを押した際に投稿削除フローを呼び出すトリガー。",
      "required": false,
      "events": [
        {
          "id": "confirm",
          "label": "削除実行",
          "handlerFlowId": "post-delete",
          "argumentMapping": {
            "postId": "@screen.post-detail.item.postId"
          }
        }
      ]
    }
  ],
  "design": {
    "designFileRef": "post-detail.design.json"
  }
}
