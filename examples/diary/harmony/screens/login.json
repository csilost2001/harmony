{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "login",
  "uuid": "a5088d22-4ad8-4615-a4c5-447ff9cdd280",
  "name": "ログイン",
  "description": "ミニマリスト風のログイン画面。中央配置カードにロゴ + username/passwordフィールド + ログインボタン + 管理者依頼ヒントテキストを配置。loginButton.events で `ログイン` ProcessFlow と結線。",
  "kind": "login",
  "path": "/login",
  "auth": "none",
  "maturity": "draft",
  "createdAt": "2026-05-06T14:30:00.000Z",
  "updatedAt": "2026-05-07T00:00:00.000Z",
  "items": [
    {
      "id": "username",
      "label": "ユーザー名",
      "type": "string",
      "direction": "in",
      "description": "ログイン用のユーザー名またはメールアドレス。",
      "required": true,
      "maxLength": 100,
      "placeholder": "ユーザー名またはメールアドレス"
    },
    {
      "id": "password",
      "label": "パスワード",
      "type": "string",
      "direction": "in",
      "description": "ログイン用のパスワード。",
      "required": true,
      "minLength": 8,
      "maxLength": 128,
      "placeholder": "パスワードを入力"
    },
    {
      "id": "rememberMe",
      "label": "ログイン状態を保持",
      "type": "boolean",
      "direction": "in",
      "description": "チェック時にJWT有効期限を延長してログイン状態を維持する。",
      "defaultValue": false,
      "required": false
    },
    {
      "id": "loginButton",
      "label": "ログイン",
      "type": "string",
      "direction": "in",
      "description": "ログインボタン。クリック (submit) で ログイン ProcessFlow を起動し、成功時に accessToken/refreshToken を localStorage に保存して投稿一覧に遷移する想定。",
      "required": false,
      "events": [
        {
          "id": "submit",
          "label": "ログイン実行",
          "handlerFlowId": "login",
          "argumentMapping": {
            "username": "@screen.login.item.username",
            "password": "@screen.login.item.password",
            "rememberMe": "@screen.login.item.rememberMe"
          }
        }
      ]
    }
  ],
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "My Diary",
          "level": 1
        }
      },
      {
        "id": "text",
        "type": "text",
        "props": {
          "text": "あなたの毎日を記録しましょう"
        }
      },
      {
        "id": "username",
        "type": "field",
        "itemRef": "username"
      },
      {
        "id": "text2",
        "type": "text",
        "props": {
          "text": "パスワード"
        }
      },
      {
        "id": "password",
        "type": "field",
        "itemRef": "password"
      },
      {
        "id": "buttons",
        "type": "button-bar",
        "children": [
          {
            "id": "button",
            "type": "button",
            "props": {
              "label": "ボタン",
              "variant": "secondary"
            }
          }
        ],
        "props": {
          "align": "center"
        }
      },
      {
        "id": "rememberMe",
        "type": "field",
        "itemRef": "rememberMe"
      },
      {
        "id": "buttons2",
        "type": "button-bar",
        "children": [
          {
            "id": "loginButton",
            "type": "button",
            "itemRef": "loginButton",
            "props": {
              "label": "ログイン",
              "variant": "secondary"
            }
          }
        ],
        "props": {
          "align": "center"
        }
      },
      {
        "id": "text3",
        "type": "text",
        "props": {
          "text": "アカウントをお持ちでない方は、管理者にアカウント作成を依頼してください。"
        }
      },
      {
        "id": "text4",
        "type": "text",
        "props": {
          "text": "My Diary v1.0.0"
        }
      }
    ]
  }
}
