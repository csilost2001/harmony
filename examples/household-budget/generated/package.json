{
  "name": "household-budget-generated",
  "version": "0.0.1",
  "description": "Generated app for household-budget sample (ISSUE #1306) — NestJS + Next.js + Prisma + SQLite + JWT + Tailwind",
  "private": true,
  "scripts": {
    "test:p4": "playwright test --config=test/playwright.config.ts",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "db:seed": "prisma generate && ts-node prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "build:frontend": "next build",
    "start:backend": "DATABASE_URL=file:./prisma/dev.db ts-node src/main.ts",
    "start:frontend": "next dev -p 3000"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "next": "^14.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "jest": "^29.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "notes": "ISSUE #1306 household-budget generated app skeleton. Run: npm install && npm run db:reset to initialize."
}
