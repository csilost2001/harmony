{
  "$schema": "../../../../schemas/v3/process-flow.v3.schema.json",
  "meta": {
    "id": "3a000000-5000-4000-8000-000000000003",
    "name": "月次レポート取得",
    "description": "指定年月の収支レポートを集計して返す。v_monthly_summary view を category JOIN で展開し、UI が描画しやすい配列形式に整形して返却。",
    "createdAt": "2026-05-24T00:00:00.000Z",
    "updatedAt": "2026-05-24T00:00:00.000Z",
    "maturity": "draft",
    "flowType": "screen",
    "screenId": "3a000000-2000-4000-8000-000000000005",
    "apiVersion": "v1",
    "mode": "upstream"
  },
  "context": {
    "catalogs": {
      "errors": {
        "INVALID_YEAR_MONTH": {
          "httpStatus": 400,
          "defaultMessage": "対象月の形式が不正です。YYYY-MM で指定してください。",
          "responseId": "400-validation",
          "exceptionTypeRef": "generic-definitions/exception-type/ValidationException"
        }
      }
    },
    "ambientVariables": [
      {
        "name": "sessionUserId",
        "label": "セッションユーザー ID",
        "type": "integer",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "id": "act-fetch-monthly-report",
      "name": "月次レポート取得",
      "trigger": "load",
      "description": "対象年月の収支レポートを取得する。",
      "inputs": [
        { "name": "yearMonth", "label": "対象月 (YYYY-MM)", "type": "string", "required": true, "format": "^\\d{4}-(0[1-9]|1[0-2])$" }
      ],
      "outputs": [
        {
          "name": "report",
          "label": "月次レポート",
          "type": {
            "kind": "object",
            "fields": [
              { "name": "yearMonth", "type": "string" },
              { "name": "totalIncome", "type": "number" },
              { "name": "totalExpense", "type": "number" },
              {
                "name": "categoryBreakdown",
                "type": {
                  "kind": "array",
                  "itemType": {
                    "kind": "object",
                    "fields": [
                      { "name": "categoryName", "type": "string" },
                      { "name": "categoryType", "type": "string" },
                      { "name": "color", "type": "string" },
                      { "name": "amount", "type": "number" }
                    ]
                  }
                }
              }
            ]
          }
        }
      ],
      "httpRoute": {
        "method": "GET",
        "path": "/api/reports/monthly",
        "auth": "required"
      },
      "responses": [
        {
          "id": "200-ok",
          "status": 200,
          "contentType": "application/json",
          "description": "月次集計結果。"
        },
        {
          "id": "400-validation",
          "status": 400,
          "contentType": "application/json",
          "description": "yearMonth が不正形式。"
        }
      ],
      "steps": [
        {
          "id": "step-01-validate",
          "kind": "validation",
          "description": "yearMonth が YYYY-MM 形式かをチェック。",
          "fieldErrorsVar": "fieldErrors",
          "rules": [
            { "field": "yearMonth", "type": "required", "severity": "error", "message": "@conv.msg.required",         "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "yearMonth", "type": "regex", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$", "severity": "error", "message": "@conv.msg.invalidFormat", "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" }
          ],
          "inlineBranch": {
            "ok": [],
            "ng": [],
            "ngResponseId": "400-validation",
            "ngBodyExpression": "${ { errors: @fieldErrors } }"
          }
        },
        {
          "id": "step-02-fetch-breakdown",
          "kind": "dbAccess",
          "description": "カテゴリ別の金額合計を SELECT。strftime で対象月のみに絞り込む。",
          "tableId": "3a000000-1000-4000-8000-000000000004",
          "operation": "SELECT",
          "sql": "SELECT c.name AS categoryName, c.category_type AS categoryType, c.color AS color, SUM(t.amount) AS amount FROM transactions t JOIN categories c ON c.id = t.category_id WHERE t.user_id = @sessionUserId AND strftime('%Y-%m', t.occurred_on) = @yearMonth GROUP BY c.id, c.name, c.category_type, c.color ORDER BY amount DESC",
          "outputBinding": { "name": "categoryBreakdown" }
        },
        {
          "id": "step-03-fetch-totals",
          "kind": "dbAccess",
          "description": "収入合計と支出合計を別 SELECT で取得。SQLite では FILTER (WHERE ...) が 3.30 以降で使えるためそちらでも可。",
          "tableId": "3a000000-1000-4000-8000-000000000004",
          "operation": "SELECT",
          "sql": "SELECT COALESCE(SUM(CASE WHEN c.category_type = 'income'  THEN t.amount ELSE 0 END), 0) AS totalIncome, COALESCE(SUM(CASE WHEN c.category_type = 'expense' THEN t.amount ELSE 0 END), 0) AS totalExpense FROM transactions t JOIN categories c ON c.id = t.category_id WHERE t.user_id = @sessionUserId AND strftime('%Y-%m', t.occurred_on) = @yearMonth",
          "outputBinding": { "name": "totals" }
        },
        {
          "id": "step-04-compose",
          "kind": "compute",
          "description": "categoryBreakdown と totals をひとつの report object にまとめる。",
          "expression": "${ { yearMonth: @yearMonth, totalIncome: @totals.totalIncome, totalExpense: @totals.totalExpense, categoryBreakdown: @categoryBreakdown } }",
          "outputBinding": { "name": "report" }
        },
        {
          "id": "step-05-return",
          "kind": "return",
          "description": "報告書を 200 で返却。",
          "responseId": "200-ok",
          "bodyExpression": "${@report}"
        }
      ]
    }
  ]
}
