{
  "$schema": "../../../../schemas/v3/process-flow.v3.schema.json",
  "meta": {
    "id": "3a000000-5000-4000-8000-000000000004",
    "name": "取引更新",
    "description": "取引編集画面の 2 アクション処理フロー: (1) 画面 mount 時に load action で対象取引を取得して loadedTransaction に bind、(2) submit 時に update action で UPDATE を実行する。所有者チェック (user_id=@sessionUserId) を WHERE に含め、他ユーザーの取引を編集できないよう SQL 層で防御。",
    "createdAt": "2026-05-24T00:00:00.000Z",
    "updatedAt": "2026-05-24T00:00:00.000Z",
    "maturity": "draft",
    "flowType": "screen",
    "screenId": "3a000000-2000-4000-8000-000000000006",
    "apiVersion": "v1",
    "mode": "upstream"
  },
  "context": {
    "catalogs": {
      "errors": {
        "VALIDATION_FAILED": {
          "httpStatus": 400,
          "defaultMessage": "入力エラーがあります。",
          "responseId": "400-validation",
          "exceptionTypeRef": "generic-definitions/exception-type/ValidationException"
        },
        "NOT_FOUND": {
          "httpStatus": 404,
          "defaultMessage": "対象の取引が見つかりません。",
          "responseId": "404-not-found",
          "exceptionTypeRef": "generic-definitions/exception-type/TransactionNotFoundException"
        }
      },
      "events": {
        "transaction.updated": {
          "description": "既存取引が更新されたことを通知する domain event (before / after を含む)。詳細: generic-definitions/domain-event/TransactionUpdated."
        }
      }
    },
    "ambientVariables": [
      {
        "name": "sessionUserId",
        "label": "セッションユーザー ID",
        "type": "integer",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "id": "act-load-transaction",
      "name": "取引を取得",
      "trigger": "load",
      "description": "編集画面 mount 時に対象取引を取得し loadedTransaction として返す。",
      "inputs": [
        { "name": "transactionId", "label": "取引 ID", "type": "integer", "required": true }
      ],
      "outputs": [
        { "name": "loadedTransaction", "label": "読み込まれた取引", "type": { "kind": "tableRow", "tableId": "3a000000-1000-4000-8000-000000000004" } }
      ],
      "httpRoute": {
        "method": "GET",
        "path": "/api/transactions/:transactionId",
        "auth": "required"
      },
      "responses": [
        { "id": "200-ok",        "status": 200, "contentType": "application/json", "description": "取引データを返却。" },
        { "id": "404-not-found", "status": 404, "contentType": "application/json", "description": "存在しない or 別ユーザー所有。" }
      ],
      "steps": [
        {
          "id": "step-01-load",
          "kind": "dbAccess",
          "description": "transactions から 1 行 SELECT。user_id 一致を WHERE に含める。",
          "tableId": "3a000000-1000-4000-8000-000000000004",
          "operation": "SELECT",
          "sql": "SELECT id, user_id, account_id, category_id, occurred_on, amount, memo, created_at, updated_at FROM transactions WHERE id = @transactionId AND user_id = @sessionUserId",
          "outputBinding": { "name": "loadedTransaction" },
          "affectedRowsCheck": {
            "operator": "=",
            "expected": 1,
            "onViolation": "throw",
            "errorCode": "NOT_FOUND"
          }
        },
        {
          "id": "step-02-return",
          "kind": "return",
          "description": "200 で返却。",
          "responseId": "200-ok",
          "bodyExpression": "${@loadedTransaction}"
        }
      ]
    },
    {
      "id": "act-update-transaction",
      "name": "取引を更新",
      "trigger": "submit",
      "description": "編集フォームの submit 時に対象取引を更新する。",
      "inputs": [
        { "name": "transactionId", "label": "取引 ID", "type": "integer", "required": true },
        { "name": "occurredOn",    "label": "取引日",   "type": "date",    "required": true },
        { "name": "accountId",     "label": "口座 ID",  "type": "integer", "required": true },
        { "name": "categoryId",    "label": "カテゴリ ID","type": "integer", "required": true },
        { "name": "amount",        "label": "金額",     "type": "number",  "required": true },
        { "name": "memo",          "label": "メモ",     "type": "string",  "required": false }
      ],
      "outputs": [
        { "name": "updatedTransaction", "label": "更新後の取引", "type": { "kind": "tableRow", "tableId": "3a000000-1000-4000-8000-000000000004" } }
      ],
      "httpRoute": {
        "method": "PUT",
        "path": "/api/transactions/:transactionId",
        "auth": "required"
      },
      "responses": [
        { "id": "200-ok",         "status": 200, "contentType": "application/json", "description": "更新成功、更新後の行を返却。" },
        { "id": "400-validation", "status": 400, "contentType": "application/json", "description": "入力バリデーション失敗。" },
        { "id": "404-not-found",  "status": 404, "contentType": "application/json", "description": "存在しない or 別ユーザー所有。" }
      ],
      "steps": [
        {
          "id": "step-01-validate",
          "kind": "validation",
          "description": "新規入力と同じバリデーション規則。",
          "fieldErrorsVar": "fieldErrors",
          "rules": [
            { "field": "occurredOn", "type": "required",  "severity": "error", "message": "@msg.FieldRequired",        "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "accountId",  "type": "required",  "severity": "error", "message": "@msg.FieldRequired",        "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "categoryId", "type": "required",  "severity": "error", "message": "@msg.FieldRequired",        "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "amount",     "type": "required",  "severity": "error", "message": "@msg.FieldRequired",        "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "amount",     "type": "range",     "min": 1, "max": 100000000, "severity": "error", "message": "@msg.AmountOutOfRange", "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" },
            { "field": "memo",       "type": "maxLength", "length": 200, "severity": "error", "message": "@msg.MemoMaxLength", "exceptionTypeRef": "generic-definitions/exception-type/ValidationException" }
          ],
          "inlineBranch": {
            "ok": [],
            "ng": [],
            "ngResponseId": "400-validation",
            "ngBodyExpression": "${ { errors: @fieldErrors } }"
          }
        },
        {
          "id": "step-02-before-snapshot",
          "kind": "dbAccess",
          "description": "更新前の snapshot を取得 (TransactionUpdated event payload の before に使用)。",
          "tableId": "3a000000-1000-4000-8000-000000000004",
          "operation": "SELECT",
          "sql": "SELECT id, user_id, account_id, category_id, occurred_on, amount, memo, created_at, updated_at FROM transactions WHERE id = @transactionId AND user_id = @sessionUserId",
          "outputBinding": { "name": "beforeSnapshot" },
          "affectedRowsCheck": {
            "operator": "=",
            "expected": 1,
            "onViolation": "throw",
            "errorCode": "NOT_FOUND"
          }
        },
        {
          "id": "step-03-update",
          "kind": "dbAccess",
          "description": "user_id 一致を WHERE に含めて UPDATE。affectedRows=0 なら 404 へ。",
          "tableId": "3a000000-1000-4000-8000-000000000004",
          "operation": "UPDATE",
          "sql": "UPDATE transactions SET account_id = @accountId, category_id = @categoryId, occurred_on = @occurredOn, amount = @amount, memo = @memo, updated_at = CURRENT_TIMESTAMP WHERE id = @transactionId AND user_id = @sessionUserId RETURNING id, user_id, account_id, category_id, occurred_on, amount, memo, created_at, updated_at",
          "outputBinding": { "name": "updatedTransaction" },
          "affectedRowsCheck": {
            "operator": "=",
            "expected": 1,
            "onViolation": "throw",
            "errorCode": "NOT_FOUND"
          }
        },
        {
          "id": "step-04-publish",
          "kind": "eventPublish",
          "description": "transaction.updated domain event を発行 (before / after を含む)。差分監査ログ等の subscriber が利用。詳細: generic-definitions/domain-event/TransactionUpdated。",
          "topic": "transaction.updated",
          "payload": "${ { transactionId: @transactionId, userId: @sessionUserId, before: @beforeSnapshot, after: @updatedTransaction, updatedAt: @updatedTransaction.updated_at } }"
        },
        {
          "id": "step-05-return",
          "kind": "return",
          "description": "更新後の行を 200 で返却。",
          "responseId": "200-ok",
          "bodyExpression": "${@updatedTransaction}"
        }
      ]
    }
  ]
}
