{
  "$schema": "../../../../schemas/v3/table.v3.schema.json",
  "id": "transaction",
  "uuid": "3a000000-1000-4000-8000-000000000004",
  "name": "取引",
  "description": "本アプリの中核テーブル。1 行 = 1 件の収入 / 支出。口座とカテゴリへの FK を持ち、occurred_on で時系列分析する。",
  "createdAt": "2026-05-24T00:00:00.000Z",
  "updatedAt": "2026-05-24T00:00:00.000Z",
  "maturity": "draft",
  "physicalName": "transactions",
  "category": "トランザクション",
  "comment": "日々の収支取引ログ。",
  "columns": [
    {
      "id": "col-id",
      "no": 1,
      "physicalName": "id",
      "name": "ID",
      "dataType": "INTEGER",
      "notNull": true,
      "primaryKey": true,
      "autoIncrement": true
    },
    {
      "id": "col-user-id",
      "no": 2,
      "physicalName": "user_id",
      "name": "ユーザー ID",
      "dataType": "INTEGER",
      "notNull": true
    },
    {
      "id": "col-account-id",
      "no": 3,
      "physicalName": "account_id",
      "name": "口座 ID",
      "dataType": "INTEGER",
      "notNull": true,
      "comment": "対象口座 (現金 / 銀行 / カード等)。"
    },
    {
      "id": "col-category-id",
      "no": 4,
      "physicalName": "category_id",
      "name": "カテゴリ ID",
      "dataType": "INTEGER",
      "notNull": true,
      "comment": "本取引のカテゴリ。category_type で income / expense を判別する。"
    },
    {
      "id": "col-occurred-on",
      "no": 5,
      "physicalName": "occurred_on",
      "name": "取引日",
      "dataType": "DATE",
      "notNull": true,
      "comment": "業務日付。created_at とは別概念 (過去日付の遡及登録可)。"
    },
    {
      "id": "col-amount",
      "no": 6,
      "physicalName": "amount",
      "name": "金額",
      "dataType": "DECIMAL",
      "length": 12,
      "scale": 2,
      "notNull": true,
      "comment": "常に正値。収入 / 支出の符号は category_type で判別する。"
    },
    {
      "id": "col-memo",
      "no": 7,
      "physicalName": "memo",
      "name": "メモ",
      "dataType": "VARCHAR",
      "length": 200,
      "comment": "自由記述 (店名 / 商品名 / 用途等)。"
    },
    {
      "id": "col-created-at",
      "no": 8,
      "physicalName": "created_at",
      "name": "作成日時",
      "dataType": "TIMESTAMP",
      "notNull": true,
      "defaultValue": "CURRENT_TIMESTAMP"
    },
    {
      "id": "col-updated-at",
      "no": 9,
      "physicalName": "updated_at",
      "name": "更新日時",
      "dataType": "TIMESTAMP",
      "notNull": true,
      "defaultValue": "CURRENT_TIMESTAMP"
    }
  ],
  "constraints": [
    {
      "id": "fk-tx-user",
      "kind": "foreignKey",
      "physicalName": "fk_tx_user",
      "columnIds": [
        "col-user-id"
      ],
      "referencedTableId": "user",
      "referencedColumnIds": [
        "col-id"
      ],
      "onDelete": "cascade",
      "onUpdate": "cascade"
    },
    {
      "id": "fk-tx-account",
      "kind": "foreignKey",
      "physicalName": "fk_tx_account",
      "columnIds": [
        "col-account-id"
      ],
      "referencedTableId": "account",
      "referencedColumnIds": [
        "col-id"
      ],
      "onDelete": "restrict",
      "onUpdate": "cascade",
      "description": "使用中の口座は削除を禁止 (取引履歴保全)。"
    },
    {
      "id": "fk-tx-category",
      "kind": "foreignKey",
      "physicalName": "fk_tx_category",
      "columnIds": [
        "col-category-id"
      ],
      "referencedTableId": "category",
      "referencedColumnIds": [
        "col-id"
      ],
      "onDelete": "restrict",
      "onUpdate": "cascade",
      "description": "使用中のカテゴリは削除を禁止。"
    },
    {
      "id": "ck-tx-amount-positive",
      "kind": "check",
      "physicalName": "ck_tx_amount_positive",
      "expression": "amount > 0",
      "description": "金額は常に正値。"
    }
  ],
  "indexes": [
    {
      "id": "idx-tx-user-occurred",
      "physicalName": "idx_tx_user_occurred",
      "columns": [
        {
          "columnId": "col-user-id"
        },
        {
          "columnId": "col-occurred-on",
          "order": "desc"
        }
      ],
      "description": "月次集計 / 一覧画面の主要クエリ index。"
    },
    {
      "id": "idx-tx-category",
      "physicalName": "idx_tx_category",
      "columns": [
        {
          "columnId": "col-category-id"
        }
      ],
      "description": "カテゴリ別集計用。"
    }
  ]
}
