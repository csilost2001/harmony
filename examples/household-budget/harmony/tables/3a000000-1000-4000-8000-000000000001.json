      "no": 1,
      "physicalName": "id",
      "name": "ID",
      "dataType": "INTEGER",
      "notNull": true,
      "primaryKey": true,
      "autoIncrement": true,
      "comment": "サロゲートキー (SQLite ROWID 連動)。"
    },
    {
      "id": "col-login-id",
      "no": 2,
      "physicalName": "login_id",
