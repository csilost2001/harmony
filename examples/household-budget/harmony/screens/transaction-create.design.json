            "type": "wrapper",
            "components": "\n<div class=\"min-h-screen bg-gradient-to-b from-indigo-50 via-white to-white pb-32\">\n\n  <header class=\"px-5 pt-8 pb-4 flex items-center gap-3\">\n    <a href=\"/transactions\" class=\"text-slate-400 hover:text-slate-600 text-xl\" aria-label=\"キャンセル\">×</a>\n    <h1 class=\"text-xl font-bold text-slate-800 flex-1\">新しい取引</h1>\n  </header>\n\n  <!-- 大きな金額入力 -->\n  <div class=\"px-5 pt-4 pb-8 text-center\">\n    <div class=\"inline-flex items-baseline gap-2 mb-2\">\n      <span class=\"text-4xl font-light text-slate-400\">¥</span>\n      <input id=\"amount\" name=\"amount\" data-item-id=\"amount\" type=\"text\" inputmode=\"numeric\" placeholder=\"0\" value=\"\" class=\"text-6xl font-bold text-slate-900 bg-transparent border-0 focus:outline-none tabular-nums w-48 text-center placeholder:text-slate-300\">\n    </div>\n    <p class=\"text-xs text-slate-400 tracking-wider\">金額を入力</p>\n  </div>\n\n  <!-- 種別タブ -->\n  <div class=\"px-5 mb-5\">\n    <div class=\"grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-2xl\">\n      <button class=\"py-2.5 rounded-xl bg-white shadow-sm text-sm font-semibold text-rose-600\">支出</button>\n      <button class=\"py-2.5 rounded-xl text-sm font-semibold text-slate-500\">収入</button>\n    </div>\n  </div>\n\n  <!-- フォームカード -->\n  <div class=\"px-5\">\n    <div class=\"bg-white rounded-3xl shadow-xl border border-slate-100 divide-y divide-slate-100 overflow-hidden\">\n\n      <div class=\"flex items-center gap-4 px-5 py-4\">\n        <span class=\"text-slate-400 text-lg flex-shrink-0 w-6\">📅</span>\n        <label for=\"occurredOn\" class=\"text-sm font-semibold text-slate-600 flex-shrink-0\">日付</label>\n        <input id=\"occurredOn\" name=\"occurredOn\" data-item-id=\"occurredOn\" type=\"date\" class=\"flex-1 text-right text-sm text-slate-800 bg-transparent border-0 focus:outline-none\">\n      </div>\n\n      <div class=\"flex items-center gap-4 px-5 py-4\">\n        <span class=\"text-slate-400 text-lg flex-shrink-0 w-6\">🏷</span>\n        <label for=\"categoryId\" class=\"text-sm font-semibold text-slate-600 flex-shrink-0\">カテゴリ</label>\n        <select id=\"categoryId\" name=\"categoryId\" data-item-id=\"categoryId\" class=\"flex-1 text-right text-sm text-slate-800 bg-transparent border-0 focus:outline-none\">\n          <option value=\"\">選択してください</option>\n          <option value=\"1\">🍴 食費</option>\n          <option value=\"2\">🚆 交通費</option>\n          <option value=\"3\">🏠 住居費</option>\n          <option value=\"4\">⚡ 光熱費</option>\n          <option value=\"5\">📱 通信費</option>\n          <option value=\"6\">🎮 娯楽</option>\n          <option value=\"7\">🩺 医療費</option>\n          <option value=\"8\">○ その他支出</option>\n        </select>\n      </div>\n\n      <div class=\"flex items-center gap-4 px-5 py-4\">\n        <span class=\"text-slate-400 text-lg flex-shrink-0 w-6\">💳</span>\n        <label for=\"accountId\" class=\"text-sm font-semibold text-slate-600 flex-shrink-0\">口座</label>\n        <select id=\"accountId\" name=\"accountId\" data-item-id=\"accountId\" class=\"flex-1 text-right text-sm text-slate-800 bg-transparent border-0 focus:outline-none\">\n          <option value=\"\">選択してください</option>\n          <option value=\"1\">💵 財布</option>\n          <option value=\"2\">🏦 みずほ銀行</option>\n          <option value=\"3\">💳 楽天カード</option>\n        </select>\n      </div>\n\n      <div class=\"flex items-start gap-4 px-5 py-4\">\n        <span class=\"text-slate-400 text-lg flex-shrink-0 w-6 pt-0.5\">📝</span>\n        <label for=\"memo\" class=\"text-sm font-semibold text-slate-600 flex-shrink-0 pt-0.5\">メモ</label>\n        <input id=\"memo\" name=\"memo\" data-item-id=\"memo\" type=\"text\" placeholder=\"店名 / 用途など (任意)\" maxlength=\"200\" class=\"flex-1 text-right text-sm text-slate-800 bg-transparent border-0 focus:outline-none placeholder:text-slate-300\">\n      </div>\n\n    </div>\n  </div>\n\n  <!-- 保存ボタン (固定) -->\n  <div class=\"fixed bottom-0 left-0 right-0 px-5 py-4 bg-gradient-to-t from-white via-white to-transparent\">\n    <button id=\"submitButton\" name=\"submitButton\" data-item-id=\"submitButton\" class=\"w-full py-4 rounded-2xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold text-base shadow-2xl hover:scale-[1.02] transition\">登録する</button>\n  </div>\n\n</div>\n"
          }
        }
