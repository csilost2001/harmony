{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "dashboard",
  "uuid": "3a000000-2000-4000-8000-000000000001",
  "name": "ダッシュボード",
  "description": "アプリ起動時の最初に表示される画面。当月の収入合計・支出合計・差引残高に加え、直近の取引 (5 件) と支出カテゴリ別ドーナツチャートを 1 画面に集約する。Tailwind の gradient hero + soft shadow card grid + rounded-2xl で先進的な見た目を実現する想定。",
  "createdAt": "2026-05-24T00:00:00.000Z",
  "updatedAt": "2026-05-24T00:00:00.000Z",
  "maturity": "draft",
  "kind": "dashboard",
  "purpose": "page",
  "path": "/",
  "groupId": "household-budget",
  "auth": "required",
  "processFlowId": "dashboard-data-get",
  "items": [
    {
      "id": "currentMonthIncome",
      "label": "今月の収入",
      "type": "number",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "helperText": "当月 (1 日 〜 月末) の収入合計。fetchDashboardData flow が strftime('%Y-%m','now') で当月絞り込みして算出。",
      "binding": {
        "kind": "flowVariable",
        "path": "summary.monthlyIncome"
      }
    },
    {
      "id": "currentMonthExpense",
      "label": "今月の支出",
      "type": "number",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "helperText": "当月の支出合計。fetchDashboardData flow から取得。",
      "binding": {
        "kind": "flowVariable",
        "path": "summary.monthlyExpense"
      }
    },
    {
      "id": "currentMonthBalance",
      "label": "今月の収支",
      "type": "number",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "helperText": "収入 - 支出 (fetchDashboardData flow の compute step で導出済)。正値=黒字、負値=赤字。",
      "binding": {
        "kind": "flowVariable",
        "path": "summary.balance"
      }
    },
    {
      "id": "recentTransactions",
      "label": "直近の取引",
      "type": {
        "kind": "tableList",
        "tableId": "transaction"
      },
      "direction": "out",
      "helperText": "occurred_on 降順で 5 件のみ表示。クリックで一覧画面へ遷移。",
      "binding": {
        "kind": "flowVariable",
        "path": "recentTransactionRows"
      },
      "presentation": {
        "kind": "table",
        "viewDefinitionId": "transaction-list-viewer"
      }
    }
  ],
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "text",
        "type": "text",
        "props": {
          "text": "Dashboard"
        }
      },
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "家計簿",
          "level": 1
        }
      },
      {
        "id": "buttons",
        "type": "button-bar",
        "children": [
          {
            "id": "button",
            "type": "button",
            "props": {
              "label": "⚙",
              "variant": "secondary"
            }
          }
        ],
        "props": {
          "align": "between"
        }
      },
      {
        "id": "text2",
        "type": "text",
        "props": {
          "text": "こんにちは、デモユーザーさん 👋"
        }
      },
      {
        "id": "text3",
        "type": "text",
        "props": {
          "text": "2026年 6月"
        }
      },
      {
        "id": "text4",
        "type": "text",
        "props": {
          "text": "収入"
        }
      },
      {
        "id": "currentMonthIncome",
        "type": "field",
        "itemRef": "currentMonthIncome"
      },
      {
        "id": "text5",
        "type": "text",
        "props": {
          "text": "支出"
        }
      },
      {
        "id": "currentMonthExpense",
        "type": "field",
        "itemRef": "currentMonthExpense"
      },
      {
        "id": "text6",
        "type": "text",
        "props": {
          "text": "収支"
        }
      },
      {
        "id": "currentMonthBalance",
        "type": "field",
        "itemRef": "currentMonthBalance"
      },
      {
        "id": "buttons2",
        "type": "button-bar",
        "children": [
          {
            "id": "addLink",
            "type": "link",
            "props": {
              "label": "＋ 追加",
              "screenRef": "transaction-create"
            }
          },
          {
            "id": "listLink",
            "type": "link",
            "props": {
              "label": "📋 一覧",
              "screenRef": "transaction-list"
            }
          },
          {
            "id": "link",
            "type": "link",
            "props": {
              "label": "📊 レポート",
              "screenRef": "monthly-report"
            }
          },
          {
            "id": "link2",
            "type": "link",
            "props": {
              "label": "🏷 カテゴリ",
              "screenRef": "category-management"
            }
          }
        ]
      },
      {
        "id": "heading2",
        "type": "heading",
        "props": {
          "text": "直近の取引",
          "level": 2
        }
      },
      {
        "id": "buttons3",
        "type": "button-bar",
        "children": [
          {
            "id": "link3",
            "type": "link",
            "props": {
              "label": "すべて見る →",
              "screenRef": "transaction-list"
            }
          }
        ],
        "props": {
          "align": "between"
        }
      },
      {
        "id": "recentTransactions",
        "type": "table",
        "itemRef": "recentTransactions"
      },
      {
        "id": "link4",
        "type": "link",
        "props": {
          "label": "＋",
          "screenRef": "transaction-create"
        }
      }
    ]
  }
}
