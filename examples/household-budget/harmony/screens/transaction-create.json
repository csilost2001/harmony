{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "transaction-create",
  "uuid": "3a000000-2000-4000-8000-000000000003",
  "name": "取引入力",
  "description": "新規取引を登録するフォーム。occurredOn (default=今日) / accountId / categoryId / amount / memo を入力し、submit で createTransaction flow を実行する。Tailwind で大きめ余白 + 段組み + キーパッド風数値入力で B2C UX を目指す。",
  "createdAt": "2026-05-24T00:00:00.000Z",
  "updatedAt": "2026-05-24T00:00:00.000Z",
  "maturity": "draft",
  "kind": "form",
  "purpose": "page",
  "path": "/transactions/new",
  "groupId": "household-budget",
  "auth": "required",
  "processFlowId": "transaction-create",
  "items": [
    {
      "id": "occurredOn",
      "label": "取引日",
      "type": "date",
      "direction": "in",
      "required": true,
      "defaultValue": null,
      "helperText": "default は当日。過去日付の遡及入力可。",
      "errorMessages": {
        "required": "取引日は必須です。"
      }
    },
    {
      "id": "accountId",
      "label": "口座",
      "type": "integer",
      "direction": "in",
      "required": true,
      "placeholder": "選択してください",
      "helperText": "accounts テーブルから select で取得 (初期は単一口座運用、複数口座は将来追加)。",
      "errorMessages": {
        "required": "口座を選択してください。"
      }
    },
    {
      "id": "categoryId",
      "label": "カテゴリ",
      "type": "integer",
      "direction": "in",
      "required": true,
      "placeholder": "選択してください",
      "helperText": "categories テーブルから select で取得。アイコン+色で視認性を向上。",
      "errorMessages": {
        "required": "カテゴリを選択してください。"
      }
    },
    {
      "id": "amount",
      "label": "金額",
      "type": "number",
      "direction": "in",
      "required": true,
      "min": 1,
      "max": 100000000,
      "step": 1,
      "displayFormat": "¥#,##0",
      "placeholder": "0",
      "helperText": "正値で入力 (収入 / 支出の符号はカテゴリで判別)。",
      "errorMessages": {
        "required": "金額は必須です。",
        "outOfRange": "1 円以上 1 億円以下で入力してください。"
      }
    },
    {
      "id": "memo",
      "label": "メモ",
      "type": "string",
      "direction": "in",
      "required": false,
      "maxLength": 200,
      "placeholder": "店名 / 用途など (任意)",
      "helperText": "200 文字まで。"
    },
    {
      "id": "submitButton",
      "label": "登録",
      "type": "string",
      "direction": "in",
      "events": [
        {
          "id": "click",
          "label": "保存",
          "handlerFlowId": "transaction-create",
          "argumentMapping": {
            "occurredOn": "@screen.occurredOn",
            "accountId": "@screen.accountId",
            "categoryId": "@screen.categoryId",
            "amount": "@screen.amount",
            "memo": "@screen.memo"
          }
        }
      ]
    }
  ],
  "design": {
    "editorKind": "puck",
    "cssFramework": "tailwind"
  }
}
