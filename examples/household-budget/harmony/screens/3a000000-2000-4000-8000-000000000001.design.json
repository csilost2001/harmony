center justify-center text-amber-600 text-lg\">📊</div>\n        <span class=\"text-[11px] font-semibold text-slate-700\">レポート</span>\n      </a>\n      <a href=\"/categories\" class=\"flex flex-col items-center justify-center gap-1.5 p-3 bg-white rounded-2xl shadow-sm border border-slate-100 hover:shadow-md hover:scale-105 transition-all\">\n        <div class=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg\">🏷</div>\n        <span class=\"text-[11px] font-semibold text-slate-700\">カテゴリ</span>\n      </a>\n    </div>\n  </div>\n\n  <!-- Recent transactions -->\n  <div class=\"px-5 mt-7\">\n    <div class=\"flex items-end justify-between mb-3\">\n      <h2 class=\"text-base font-bold text-slate-800\">直近の取引</h2>\n      <a href=\"/transactions\" class=\"text-xs font-semibold text-indigo-600 hover:text-indigo-700\">すべて見る →</a>\n    </div>\n    <div id=\"recentTransactions\" data-item-id=\"recentTransactions\" class=\"bg-white rounded-2xl shadow-sm border border-slate-100 divide-y divide-slate-100 overflow-hidden\">\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <div class=\"w-10 h-10 rounded-xl bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0\">💼</div>\n        <div class=\"flex-1 min-w-0\">\n          <div class=\"text-sm font-semibold text-slate-800 truncate\">フリマアプリ売上</div>\n          <div class=\"text-xs text-slate-500\">副収入 · みずほ銀行 · 6/15</div>\n        </div>\n        <div class=\"text-sm font-bold text-emerald-600 tabular-nums whitespace-nowrap\">+¥15,000</div>\n      </div>\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <div class=\"w-10 h-10 rounded-xl bg-pink-50 flex items-center justify-center text-pink-600 flex-shrink-0\">🎮</div>\n        <div class=\"flex-1 min-w-0\">\n          <div class=\"text-sm font-semibold text-slate-800 truncate\">Netflix + Spotify (年額)</div>\n          <div class=\"text-xs text-slate-500\">娯楽 · 楽天カード · 6/12</div>\n       