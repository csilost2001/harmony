{
  "$schema": "../../../../../schemas/v3/generic-definitions/ui-fragment.v3.schema.json",
  "kind": "ui-fragment",
  "name": "CategoryBadge",
  "purpose": "カテゴリの色 + アイコン + 名前を 1 つの badge コンポーネントで表現する再利用 UI 断片。",
  "responsibilities": [
    "取引一覧の各行で表示",
    "月次レポートのカテゴリ別棒グラフ凡例で表示",
    "カテゴリ管理画面のグリッドカード内で表示",
    "色 / アイコンは categories table の color / icon column から取得 (フォールバック値は constants 参照)"
  ],
  "targets": ["frontend"],
  "fields": [
    { "name": "categoryName",  "type": "string",      "description": "表示するカテゴリ名" },
    { "name": "categoryColor", "type": "string",      "constraints": ["#RRGGBB format"], "description": "背景色" },
    { "name": "categoryIcon",  "type": "string",      "description": "Lucide-React アイコン名" },
    { "name": "size",          "type": "string",      "constraints": ["'sm' | 'md' | 'lg'"], "description": "表示サイズ" }
  ],
  "mappingHints": {
    "framework": "react",
    "cssFramework": "tailwind",
    "skeletonHtml": "<span class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold\" style=\"background-color:{categoryColor}15;color:{categoryColor}\"><Icon name=\"{categoryIcon}\" size=\"12\" /><span>{categoryName}</span></span>",
    "props": {
      "categoryName":  { "type": "string", "required": true },
      "categoryColor": { "type": "string", "default": "#6366f1" },
      "categoryIcon":  { "type": "string", "default": "circle-dot" },
      "size":          { "type": "string", "default": "sm", "enum": ["sm", "md", "lg"] }
    }
  }
}
