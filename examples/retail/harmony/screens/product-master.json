{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "product-master",
  "uuid": "2e23d129-1d53-4e30-b54c-97f90b910578",
  "name": "商品マスター",
  "description": "商品マスタの一覧・検索・新規登録・編集・削除を行う補助画面。productCode / name / unitPrice / isActive を管理する。",
  "purpose": "page",
  "kind": "list",
  "path": "/master/products",
  "auth": "required",
  "groupId": "master-management",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-02T00:00:00.000Z",
  "items": [
    {
      "id": "productCodeSearch",
      "label": "商品コード",
      "type": "string",
      "direction": "in",
      "required": false,
      "maxLength": 20,
      "pattern": "@conv.regex.productCode",
      "placeholder": "例: P-0001",
      "description": "商品マスター一覧の検索条件: 商品コード。"
    },
    {
      "id": "productNameSearch",
      "label": "商品名",
      "type": "string",
      "direction": "in",
      "required": false,
      "maxLength": 100,
      "placeholder": "商品名を入力",
      "description": "商品マスター一覧の検索条件: 商品名 (部分一致)。"
    },
    {
      "id": "activeOnlyFilter",
      "label": "有効商品のみ表示",
      "type": "boolean",
      "direction": "in",
      "defaultValue": true,
      "description": "商品マスター一覧の有効フラグフィルタ。"
    },
    {
      "id": "categorySearch",
      "label": "カテゴリ",
      "type": "string",
      "direction": "in",
      "options": [
        {
          "value": "electronics",
          "label": "電子機器"
        },
        {
          "value": "peripheral",
          "label": "周辺機器"
        },
        {
          "value": "display",
          "label": "ディスプレイ"
        },
        {
          "value": "storage",
          "label": "ストレージ"
        }
      ]
    },
    {
      "id": "isActiveSearch",
      "label": "有効/無効",
      "type": "string",
      "direction": "in",
      "options": [
        {
          "value": "true",
          "label": "有効"
        },
        {
          "value": "false",
          "label": "無効"
        }
      ]
    },
    {
      "id": "productMasterRows",
      "label": "商品マスター 一覧",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "presentation": {
        "kind": "table",
