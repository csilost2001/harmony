{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "shipment-dispatch",
  "uuid": "c2254dd6-ab5d-4428-931f-d27c71e89951",
  "name": "配送指示",
  "description": "注文の配送指示を登録する (S-4)。注文詳細 (読み取り専用) にキャリア・配送希望日・時間帯を入力し指示を確定する。",
  "purpose": "page",
  "kind": "form",
  "path": "/orders/:id/dispatch",
  "auth": "required",
  "groupId": "back-office",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-02T00:00:00.000Z",
  "items": [
    {
      "id": "orderId",
      "label": "対象注文 ID",
      "type": "integer",
      "direction": "out",
      "description": "S-4 配送指示対象の注文 ID (URL :id パラメータから取得、表示専用)。",
      "binding": {
        "kind": "expression",
        "path": "@route.id"
      }
    },
    {
      "id": "carrierId",
      "label": "配送会社",
      "type": "string",
      "direction": "in",
      "required": true,
      "options": [
        {
          "value": "yamato",
          "label": "ヤマト運輸"
        },
        {
          "value": "sagawa",
          "label": "佐川急便"
        },
        {
          "value": "japanpost",
          "label": "日本郵便"
        }
      ],
      "errorMessages": {
        "required": "配送会社を選択してください。"
      },
      "description": "S-4 配送指示フォームの配送会社選択。"
    },
    {
      "id": "preferredDate",
      "label": "希望配送日",
      "type": "date",
      "direction": "in",
      "required": false,
      "description": "S-4 配送指示の希望配送日 (任意)。"
    },
    {
      "id": "timeSlot",
      "label": "希望時間帯",
      "type": "string",
      "direction": "in",
      "required": false,
      "options": [
        {
          "value": "morning",
          "label": "午前中"
        },
        {
          "value": "afternoon",
          "label": "14:00〜18:00"
        },
        {
          "value": "evening",
          "label": "18:00〜21:00"
        },
        {
          "value": "any",
          "label": "指定なし"
        }
      ],
      "description": "S-4 配送指示の希望時間帯選択 (任意)。"
    },
    {
      "id": "trackingNumber",
      "label": "追跡番号",
      "type": "string",
      "direction": "out",
      "description": "S-4 配送指示登録後に発行された追跡番号 (表示専用)。",
      "binding": {
        "kind": "flowVariable",
        "path": "trackingNumber",
        "processFlowId": "shipment-dispatch"
      }
    },
    {
      "id": "dispatchOrderButton",
      "label": "配送指示登録",
      "type": {
        "kind": "extension",
        "extensionRef": "retail:button"
      },
      "direction": "out",
      "readonly": true,
      "events": [
        {
          "id": "submit",
          "label": "配送指示登録",
          "handlerFlowId": "shipment-dispatch",
          "argumentMapping": {
            "orderId": "@screen.shipment-dispatch.item.orderId",
            "carrierId": "@screen.shipment-dispatch.item.carrierId",
            "preferredDate": "@screen.shipment-dispatch.item.preferredDate",
            "timeSlot": "@screen.shipment-dispatch.item.timeSlot"
          }
        }
      ],
      "description": "S-4 配送指示登録ボタン。クリック時に配送指示フロー (d63c703c) を起動する。"
    },
    {
      "id": "shipmentDispatchRows",
      "label": "注文商品 一覧",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "presentation": {
        "kind": "table",
        "columns": [
          {
            "id": "col1",
            "label": "商品コード",
            "path": "col1",
            "type": "string"
          },
          {
            "id": "col2",
            "label": "商品名",
            "path": "col2",
            "type": "string"
          },
          {
            "id": "col3",
            "label": "数量",
            "path": "col3",
            "type": "string"
          },
          {
            "id": "col4",
            "label": "小計",
            "path": "col4",
            "type": "string"
          }
        ]
      }
    }
  ],
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "配送指示",
          "level": 1
        }
      },
      {
        "id": "columns",
        "type": "columns",
        "children": [
          {
            "id": "column",
            "type": "column",
            "props": {
              "span": 6
            },
            "children": [
              {
                "id": "section",
                "type": "section",
                "props": {
                  "title": "注文詳細 (確認)",
                  "variant": "card"
                },
                "children": [
                  {
                    "id": "html",
                    "type": "html",
                    "props": {
                      "html": "<dl class=\"row mb-0\">\n                <dt class=\"col-sm-5 text-muted\">注文番号</dt>\n                <dd class=\"col-sm-7 font-monospace fw-bold\" id=\"orderNumberDisplay\" data-item-id=\"orderNumberDisplay\">ORD-2026-000024</dd>\n\n                <dt class=\"col-sm-5 text-muted\">顧客名</dt>\n                <dd class=\"col-sm-7\" id=\"customerNameDisplay\" data-item-id=\"customerNameDisplay\">田中 太郎</dd>\n\n                <dt class=\"col-sm-5 text-muted\">注文日時</dt>\n                <dd class=\"col-sm-7\">2026/05/02 14:32</dd>\n\n                <dt class=\"col-sm-5 text-muted\">配送先住所</dt>\n                <dd class=\"col-sm-7\" id=\"shippingAddressDisplay\" data-item-id=\"shippingAddressDisplay\">\n                  〒160-0022<br>東京都新宿区新宿 X-X-X\n                </dd>\n\n                <dt class=\"col-sm-5 text-muted\">ステータス</dt>\n                <dd class=\"col-sm-7\"><span class=\"badge bg-warning text-dark\">配送待ち</span></dd>\n              </dl>"
                    }
                  },
                  {
                    "id": "trackingNumber",
                    "type": "field",
                    "itemRef": "trackingNumber"
                  }
                ]
              },
              {
                "id": "shipmentDispatchRows",
                "type": "table",
                "itemRef": "shipmentDispatchRows",
                "props": {
                  "title": "注文商品"
                }
              }
            ]
          },
          {
            "id": "column2",
            "type": "column",
            "props": {
              "span": 6
            },
            "children": [
              {
                "id": "dispatchForm",
                "type": "form",
                "children": [
                  {
                    "id": "orderId",
                    "type": "field",
                    "itemRef": "orderId"
                  },
                  {
                    "id": "carrierId",
                    "type": "field",
                    "itemRef": "carrierId"
                  },
                  {
                    "id": "preferredDate",
                    "type": "field",
                    "itemRef": "preferredDate"
                  },
                  {
                    "id": "timeSlot",
                    "type": "field",
                    "itemRef": "timeSlot"
                  },
                  {
                    "id": "messageArea",
                    "type": "message-area"
                  },
                  {
                    "id": "buttons",
                    "type": "button-bar",
                    "children": [
                      {
                        "id": "dispatchOrderButton",
                        "type": "button",
                        "itemRef": "dispatchOrderButton",
                        "props": {
                          "label": "配送指示を登録する",
                          "variant": "primary"
                        }
                      },
                      {
                        "id": "backOrderButton",
                        "type": "button",
                        "props": {
                          "label": "注文一覧へ戻る",
                          "variant": "secondary",
                          "screenRef": "order-list"
                        }
                      }
                    ]
                  }
                ],
                "props": {
                  "title": "配送指示入力"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
