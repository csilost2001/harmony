{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "order-complete",
  "uuid": "0739c454-45d6-4c99-962a-7b0b9e113a22",
  "name": "注文完了",
  "description": "注文確定後の完了画面 (S-3)。注文番号・注文サマリを表示し、ダッシュボードまたは注文履歴への導線を提供する。",
  "purpose": "page",
  "kind": "complete",
  "path": "/order/complete",
  "auth": "required",
  "groupId": "customer-facing",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-02T00:00:00.000Z",
  "items": [
    {
      "id": "orderNumber",
      "label": "注文番号",
      "type": "string",
      "direction": "out",
      "description": "S-3 注文確定後に発行された注文番号 (ORD-YYYY-NNNNNN 形式)。",
      "binding": {
        "kind": "flowVariable",
        "path": "orderNumber",
        "processFlowId": "order-confirm"
      }
    },
    {
      "id": "confirmedTotalAmount",
      "label": "確定合計金額 (税込)",
      "type": "integer",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "description": "S-3 注文確定後の確定合計金額 (表示専用)。",
      "binding": {
        "kind": "flowVariable",
        "path": "totalAmount",
        "processFlowId": "order-confirm"
      }
    },
    {
      "id": "confirmedAt",
      "label": "注文確定日時",
      "type": "datetime",
      "direction": "out",
      "displayFormat": "YYYY/MM/DD HH:mm",
      "description": "S-3 注文確定が完了した日時 (表示専用)。",
      "binding": {
        "kind": "flowVariable",
        "path": "confirmedAt",
        "processFlowId": "order-confirm"
      }
    },
    {
      "id": "orderItems",
      "label": "注文内容 一覧",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "presentation": {
        "kind": "table",
        "columns": [
          {
            "id": "col1",
            "label": "商品コード",
            "path": "col1",
            "type": "string"
          },
          {
            "id": "col2",
            "label": "商品名",
            "path": "col2",
            "type": "string"
          },
          {
            "id": "col3",
            "label": "数量",
            "path": "col3",
            "type": "string"
          },
          {
            "id": "col4",
            "label": "小計",
            "path": "col4",
            "type": "string"
          }
        ]
      }
    }
  ],
  "design": {
    "designFileRef": "order-complete.design.json"
  },
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "text",
        "type": "text",
        "props": {
          "text": "1. カート 2. 注文確認 3. 注文完了"
        }
      },
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "注文が確定しました",
          "level": 1
        }
      },
      {
        "id": "text2",
        "type": "text",
        "props": {
          "text": "ご注文ありがとうございます。以下の注文番号でお問い合わせいただけます。",
          "tone": "muted"
        }
      },
      {
        "id": "text3",
        "type": "text",
        "props": {
          "text": "注文番号",
          "tone": "muted"
        }
      },
      {
        "id": "orderNumber",
        "type": "field",
        "itemRef": "orderNumber"
      },
      {
        "id": "orderItems",
        "type": "table",
        "itemRef": "orderItems",
        "props": {
          "title": "注文内容"
        }
      },
      {
        "id": "section",
        "type": "section",
        "props": {
          "title": "配送情報",
          "variant": "card"
        },
        "children": [
          {
            "id": "html",
            "type": "html",
            "props": {
              "html": "<dl class=\"row mb-0\">\n                <dt class=\"col-sm-4 text-muted\">配送先住所</dt>\n                <dd class=\"col-sm-8\" id=\"shippingAddressDisplay\" data-item-id=\"shippingAddressDisplay\">\n                  東京都新宿区新宿 X-X-X\n                </dd>\n                <dt class=\"col-sm-4 text-muted\">配送状況</dt>\n                <dd class=\"col-sm-8\">\n                  <span class=\"badge bg-warning text-dark\">配送指示待ち</span>\n                </dd>\n              </dl>"
            }
          }
        ]
      },
      {
        "id": "buttons",
        "type": "button-bar",
        "children": [
          {
            "id": "button",
            "type": "button",
            "props": {
              "label": "ダッシュボードへ",
              "variant": "secondary",
              "screenRef": "dashboard"
            }
          },
          {
            "id": "checkOrderButton",
            "type": "button",
            "props": {
              "label": "注文履歴を確認する",
              "variant": "primary",
              "screenRef": "order-list"
            }
          }
        ],
        "props": {
          "align": "center"
        }
      }
    ]
  }
}
