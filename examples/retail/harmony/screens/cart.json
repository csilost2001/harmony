{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "cart",
  "uuid": "c73fa05c-4a71-4593-800d-b9814e97be83",
  "name": "カート",
  "description": "商品コード・店舗・数量を入力してカートに追加する (S-2/S-3)。multi-store inventory 整合のため店舗を必須選択する。カート明細テーブルで削除・数量変更ができ、合計金額を表示する。注文確認画面への導線を提供する。",
  "purpose": "page",
  "kind": "retail:cart",
  "path": "/cart",
  "auth": "required",
  "groupId": "customer-facing",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-03T00:00:00.000Z",
  "items": [
    {
      "id": "addProductCode",
      "label": "商品コード",
      "type": "string",
      "direction": "in",
      "required": true,
      "maxLength": 20,
      "pattern": "@conv.regex.productCode",
      "placeholder": "例: P-0001",
      "errorMessages": {
        "required": "商品コードは必須です。",
        "invalidFormat": "商品コードは P-XXXX〜P-XXXXXX 形式で入力してください。"
      },
      "description": "S-2 カート追加フォームの商品コード入力。"
    },
    {
      "id": "addStoreCode",
      "label": "店舗",
      "type": "string",
      "direction": "in",
      "required": true,
      "options": [
        {
          "value": "S-001",
          "label": "東京本店"
        },
        {
          "value": "S-002",
          "label": "大阪支店"
        },
        {
          "value": "S-003",
          "label": "名古屋支店"
        }
      ],
      "errorMessages": {
        "required": "店舗を選択してください。"
      },
      "description": "S-2 カート追加フォームの店舗選択。multi-store inventory 整合のため、商品在庫を確保する店舗を必須指定する。同一商品でも別店舗から追加した場合は別行として cart_items に保持される。"
    },
    {
      "id": "addQuantity",
      "label": "数量",
      "type": "integer",
      "direction": "in",
      "required": true,
      "min": 1,
      "maxRef": "@conv.limit.cartItemMaxQuantity",
      "errorMessages": {
        "required": "数量は必須です。",
        "outOfRange": "数量は 1〜999 の範囲で入力してください。"
      },
      "description": "S-2 カート追加フォームの数量入力。maxRef で @conv.limit.cartItemMaxQuantity (999) を参照 (#734)。"
    },
    {
      "id": "cartItemCount",
      "label": "カート点数",
      "type": "integer",
      "direction": "out",
      "displayFormat": "#,##0 点",
      "description": "S-2 カート内の商品合計点数 (表示専用)。集計元はカート集計フロー (267e94bf) の itemCount。",
      "binding": {
        "kind": "flowVariable",
        "path": "itemCount",
        "processFlowId": "cart-summary"
      }
    },
    {
      "id": "cartTotalAmount",
      "label": "小計 (税抜)",
      "type": "integer",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "description": "S-2 カート内の税抜合計金額 (表示専用)。集計元はカート集計フロー (267e94bf) の totalAmount。",
      "binding": {
        "kind": "flowVariable",
        "path": "totalAmount",
        "processFlowId": "cart-summary"
      }
    },
    {
      "id": "addToCartButton",
      "label": "カートに追加",
      "type": {
        "kind": "extension",
        "extensionRef": "retail:button"
      },
      "direction": "out",
      "readonly": true,
      "events": [
        {
          "id": "submit",
          "label": "カートに追加",
          "handlerFlowId": "cart-add",
          "argumentMapping": {
            "productCode": "@screen.cart.item.addProductCode",
            "storeCode": "@screen.cart.item.addStoreCode",
            "quantity": "@screen.cart.item.addQuantity"
          }
        }
      ],
      "description": "S-2 カートに追加ボタン。クリック時にカート追加フロー (9515d6f6) を起動する。"
    },
    {
      "id": "cartItems",
      "label": "カート明細",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "presentation": {
        "kind": "table",
        "columns": [
          {
            "id": "col1",
            "label": "商品コード",
            "path": "col1",
            "type": "string"
          },
          {
            "id": "col2",
            "label": "商品名",
            "path": "col2",
            "type": "string"
          },
          {
            "id": "col3",
            "label": "単価",
            "path": "col3",
            "type": "string"
          },
          {
            "id": "col4",
            "label": "数量",
            "path": "col4",
            "type": "string"
          },
          {
            "id": "col5",
            "label": "小計",
            "path": "col5",
            "type": "string"
          }
        ]
      }
    }
  ],
  "design": {
    "designFileRef": "cart.design.json"
  },
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "カート",
          "level": 1
        }
      },
      {
        "id": "columns2",
        "type": "columns",
        "children": [
          {
            "id": "column4",
            "type": "column",
            "props": {
              "span": 8
            },
            "children": [
              {
                "id": "addItemForm",
                "type": "form",
                "props": {
                  "columns": 3,
                  "title": "商品を追加"
                },
                "children": [
                  {
                    "id": "addProductCode",
                    "type": "field",
                    "itemRef": "addProductCode"
                  },
                  {
                    "id": "addQuantity",
                    "type": "field",
                    "itemRef": "addQuantity"
                  },
                  {
                    "id": "addToCartButton",
                    "type": "button",
                    "itemRef": "addToCartButton",
                    "props": {
                      "label": "カートに追加",
                      "variant": "primary"
                    }
                  }
                ]
              },
              {
                "id": "cartItems",
                "type": "table",
                "itemRef": "cartItems",
                "props": {
                  "title": "カート明細 3 点"
                }
              }
            ]
          },
          {
            "id": "column5",
            "type": "column",
            "props": {
              "span": 4
            },
            "children": [
              {
                "id": "section",
                "type": "section",
                "props": {
                  "title": "注文サマリ",
                  "variant": "card"
                },
                "children": [
                  {
                    "id": "html",
                    "type": "html",
                    "props": {
                      "html": "<table class=\"table table-sm mb-0\">\n                <tbody>\n                  <tr>\n                    <td class=\"text-muted\">小計 (税抜)</td>\n                    <td class=\"text-end\" id=\"subtotal\" data-item-id=\"subtotal\">¥107,091</td>\n                  </tr>\n                  <tr>\n                    <td class=\"text-muted\">消費税 (10%)</td>\n                    <td class=\"text-end\" id=\"taxAmount\" data-item-id=\"taxAmount\">¥10,709</td>\n                  </tr>\n                  <tr class=\"table-active\">\n                    <td class=\"fw-bold\">合計 (税込)</td>\n                    <td class=\"text-end fw-bold fs-5\" id=\"totalAmount\" data-item-id=\"totalAmount\">¥118,800</td>\n                  </tr>\n                </tbody>\n              </table>"
                    }
                  },
                  {
                    "id": "divider",
                    "type": "divider"
                  },
                  {
                    "id": "buttons",
                    "type": "button-bar",
                    "children": [
                      {
                        "id": "checkOrderButton",
                        "type": "button",
                        "props": {
                          "label": "注文確認へ",
                          "variant": "primary",
                          "screenRef": "cart-confirm"
                        }
                      },
                      {
                        "id": "button",
                        "type": "button",
                        "props": {
                          "label": "買い物を続ける",
                          "variant": "secondary",
                          "screenRef": "product-search"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "text",
                "type": "text",
                "props": {
                  "text": "カート内の商品は最大 50 点まで追加できます。"
                }
              },
              {
                "id": "text2",
                "type": "text",
                "props": {
                  "text": "在庫が不足している商品は注文確定時にエラーが表示されます。"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
