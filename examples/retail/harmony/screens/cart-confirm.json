{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "cart-confirm",
  "uuid": "cff4a398-99cd-4aa5-bfbd-c12d5e72c5f3",
  "name": "カート確認",
  "description": "カート明細 (読み取り専用) と配送先住所を確認・入力する (S-3)。注文確定ボタンで注文確定フローを実行する。",
  "purpose": "page",
  "kind": "confirm",
  "path": "/cart/confirm",
  "auth": "required",
  "groupId": "customer-facing",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-02T00:00:00.000Z",
  "items": [
    {
      "id": "cartSummary",
      "label": "カート明細",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "description": "S-3 カート明細一覧の表示。presentation=table (#762/#771): カート集計フロー (267e94bf) の出力変数 'rows' を カート明細 ViewDefinition (f8b286e4) の列定義で表示する。id='cartSummary' は design.json の data-item-id='cartSummary' と一致する (#331 規約)。",
      "binding": {
        "kind": "flowVariable",
        "path": "rows",
        "processFlowId": "cart-summary"
      },
      "presentation": {
        "kind": "table",
        "viewDefinitionId": "cart-item-viewer"
      }
    },
    {
      "id": "shippingPostalCode",
      "label": "郵便番号",
      "type": "string",
      "direction": "in",
      "required": true,
      "maxLength": 7,
      "pattern": "@conv.regex.postalCode",
      "placeholder": "例: 1600022 (ハイフンなし7桁)",
      "errorMessages": {
        "required": "郵便番号は必須です。",
        "invalidFormat": "郵便番号はハイフンなし 7 桁の数字で入力してください。"
      },
      "description": "S-3 注文確定の配送先郵便番号。"
    },
    {
      "id": "shippingAddress",
      "label": "配送先住所",
      "type": "string",
      "direction": "in",
      "required": true,
      "maxLength": 300,
      "errorMessages": {
        "required": "配送先住所は必須です。",
        "maxLength": "配送先住所は 300 文字以内で入力してください。"
      },
      "description": "S-3 注文確定の配送先住所 (都道府県・市区町村・番地・建物名)。"
    },
    {
      "id": "note",
      "label": "備考",
      "type": "string",
      "direction": "in",
      "required": false,
      "maxLength": 500,
      "placeholder": "配送時の注意事項など",
      "description": "S-3 注文確定の備考欄 (任意)。"
    },
    {
      "id": "paymentMethod",
      "label": "支払方法",
      "type": "string",
      "direction": "in",
      "required": true,
      "options": [
        {
          "value": "credit_card",
          "label": "クレジットカード"
        },
        {
          "value": "bank_transfer",
          "label": "銀行振込"
        },
        {
          "value": "cod",
          "label": "代金引換"
        }
      ],
      "errorMessages": {
        "required": "支払方法を選択してください。"
      },
      "description": "S-3 注文確定の支払方法選択。注文確定フロー (f81dd9e0) の paymentMethod input にマッピングされる。フロー側でも enum バリデーション (credit_card / bank_transfer / cod) を行う。"
    },
    {
      "id": "confirmTotalAmount",
      "label": "注文合計 (税抜)",
      "type": "integer",
      "direction": "out",
      "displayFormat": "¥#,##0",
      "readonly": true,
      "description": "S-3 注文確定確認画面の注文合計金額 (税抜、表示専用)。集計元はカート集計フロー (267e94bf) の totalAmount。税込表示が必要な場合は呼び出し側で @conv.tax.standard.rate を適用する。",
      "binding": {
        "kind": "flowVariable",
        "path": "totalAmount",
        "processFlowId": "cart-summary"
      }
    },
    {
      "id": "confirmOrderButton",
      "label": "注文確定",
      "type": {
        "kind": "extension",
        "extensionRef": "retail:button"
      },
      "direction": "out",
      "readonly": true,
      "events": [
        {
          "id": "submit",
          "label": "注文確定",
          "handlerFlowId": "order-confirm",
          "argumentMapping": {
            "shippingPostalCode": "@screen.cart-confirm.item.shippingPostalCode",
            "shippingAddress": "@screen.cart-confirm.item.shippingAddress",
            "note": "@screen.cart-confirm.item.note",
            "paymentMethod": "@screen.cart-confirm.item.paymentMethod"
          }
        }
      ],
      "description": "S-3 注文確定ボタン。クリック時に注文確定フロー (f81dd9e0) を起動する。argumentMapping で shippingPostalCode / shippingAddress / note / paymentMethod を画面コンテキストから flow inputs に渡す。"
    }
  ],
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "注文確認",
          "level": 1
        }
      },
      {
        "id": "text",
        "type": "text",
        "props": {
          "text": "1. カート 2. 注文確認 3. 注文完了"
        }
      },
      {
        "id": "searchPanel",
        "type": "search-panel",
        "children": [
          {
            "id": "columns",
            "type": "columns",
            "children": [
              {
                "id": "column",
                "type": "column",
                "props": {
                  "span": 7
                },
                "children": [
                  {
                    "id": "cartSummary",
                    "type": "table",
                    "itemRef": "cartSummary",
                    "props": {
                      "title": "注文商品一覧 (確認)"
                    }
                  },
                  {
                    "id": "section",
                    "type": "section",
                    "props": {
                      "title": "配送先住所",
                      "variant": "card"
                    },
                    "children": [
                      {
                        "id": "text2",
                        "type": "text",
                        "props": {
                          "text": "郵便番号"
                        }
                      },
                      {
                        "id": "text3",
                        "type": "text",
                        "props": {
                          "text": "*"
                        }
                      },
                      {
                        "id": "shippingPostalCode",
                        "type": "field",
                        "itemRef": "shippingPostalCode"
                      },
                      {
                        "id": "confirmTotalAmount",
                        "type": "field",
                        "itemRef": "confirmTotalAmount"
                      },
                      {
                        "id": "searchButton",
                        "type": "button",
                        "props": {
                          "label": "住所検索",
                          "variant": "secondary"
                        }
                      },
                      {
                        "id": "text4",
                        "type": "text",
                        "props": {
                          "text": "ハイフンなし 7 桁の数字を入力してください。",
                          "tone": "muted"
                        }
                      },
                      {
                        "id": "text5",
                        "type": "text",
                        "props": {
                          "text": "郵便番号はハイフンなし 7 桁の数字で入力してください。"
                        }
                      },
                      {
                        "id": "shippingAddress",
                        "type": "field",
                        "itemRef": "shippingAddress"
                      },
                      {
                        "id": "note",
                        "type": "field",
                        "itemRef": "note"
                      },
                      {
                        "id": "paymentMethod",
                        "type": "field",
                        "itemRef": "paymentMethod"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "column2",
                "type": "column",
                "props": {
                  "span": 5
                },
                "children": [
                  {
                    "id": "section2",
                    "type": "section",
                    "props": {
                      "title": "注文確定",
                      "variant": "card"
                    },
                    "children": [
                      {
                        "id": "html",
                        "type": "html",
                        "props": {
                          "html": "<table class=\"table table-sm mb-3\">\n                  <tbody>\n                    <tr>\n                      <td class=\"text-muted\">商品合計 (税込)</td>\n                      <td class=\"text-end\">¥118,800</td>\n                    </tr>\n                    <tr>\n                      <td class=\"text-muted\">送料</td>\n                      <td class=\"text-end\">無料</td>\n                    </tr>\n                    <tr class=\"table-active\">\n                      <td class=\"fw-bold\">お支払い合計</td>\n                      <td class=\"text-end fw-bold fs-5\">¥118,800</td>\n                    </tr>\n                  </tbody>\n                </table>"
                        }
                      },
                      {
                        "id": "messageArea",
                        "type": "message-area"
                      },
                      {
                        "id": "buttons",
                        "type": "button-bar",
                        "children": [
                          {
                            "id": "confirmOrderButton",
                            "type": "button",
                            "itemRef": "confirmOrderButton",
                            "props": {
                              "label": "注文を確定する",
                              "variant": "primary"
                            }
                          },
                          {
                            "id": "backCartButton",
                            "type": "button",
                            "props": {
                              "label": "カートに戻る",
                              "variant": "secondary",
                              "screenRef": "cart"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "permissions": [
    "order:create"
  ]
}
