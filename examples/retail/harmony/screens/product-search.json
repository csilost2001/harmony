{
  "$schema": "../../../../schemas/v3/screen.v3.schema.json",
  "id": "product-search",
  "uuid": "e6147dc0-94b7-436d-ba87-d0080ac34f44",
  "name": "商品検索",
  "description": "商品コード・店舗を条件に在庫を照会する (S-1)。検索結果一覧に在庫数と低在庫バッジを表示し、カート画面への導線を提供する。",
  "purpose": "page",
  "kind": "search",
  "path": "/products/search",
  "auth": "required",
  "groupId": "customer-facing",
  "maturity": "committed",
  "createdAt": "2026-05-02T00:00:00.000Z",
  "updatedAt": "2026-05-03T00:00:00.000Z",
  "items": [
    {
      "id": "productCode",
      "label": "商品コード",
      "type": "string",
      "direction": "in",
      "required": false,
      "maxLength": 20,
      "pattern": "@conv.regex.productCode",
      "placeholder": "例: P-0001",
      "helperText": "P- で始まる 4〜6 桁の商品コードを入力してください。",
      "errorMessages": {
        "invalidFormat": "商品コードは P-XXXX〜P-XXXXXX 形式で入力してください。"
      },
      "description": "S-1 在庫照会の検索入力: 商品コード。"
    },
    {
      "id": "storeCode",
      "label": "店舗",
      "type": "string",
      "direction": "in",
      "required": true,
      "options": [
        {
          "value": "S-001",
          "label": "東京本店"
        },
        {
          "value": "S-002",
          "label": "大阪支店"
        },
        {
          "value": "S-003",
          "label": "名古屋支店"
        }
      ],
      "errorMessages": {
        "required": "店舗を選択してください。"
      },
      "description": "S-1 在庫照会の検索条件: 店舗。multi-store inventory のため必須 (店舗指定がないと API 側で 400 を返す)。"
    },
    {
      "id": "inquiredAt",
      "label": "照会日時",
      "type": "datetime",
      "direction": "out",
      "displayFormat": "YYYY/MM/DD HH:mm",
      "description": "S-1 在庫照会を実行した日時 (表示専用)。",
      "binding": {
        "kind": "expression",
        "path": "@now"
      }
    },
    {
      "id": "searchInventoryButton",
      "label": "在庫照会",
      "type": {
        "kind": "extension",
        "extensionRef": "retail:button"
      },
      "direction": "out",
      "readonly": true,
      "events": [
        {
          "id": "submit",
          "label": "在庫照会",
          "handlerFlowId": "inventory-by-store-lookup",
          "argumentMapping": {
            "productCode": "@screen.product-search.item.productCode",
            "storeCode": "@screen.product-search.item.storeCode"
          }
        }
      ],
      "description": "S-1 商品検索の在庫照会ボタン。クリック時に店舗在庫照会フロー (efa7ac6e) を起動する。"
    },
    {
      "id": "inventoryRows",
      "label": "在庫一覧",
      "type": {
        "kind": "array",
        "itemType": "json"
      },
      "direction": "out",
      "description": "S-1 商品検索結果の在庫一覧表示。presentation=table (#762/#771): 在庫照会フロー (efa7ac6e) の出力変数 'rows' を 在庫一覧 (商品検索結果) ViewDefinition (be4bece3) の列定義で表示する。検索ボタン押下後にフロー完了時点でバインドされる。",
      "binding": {
        "kind": "flowVariable",
        "path": "rows",
        "processFlowId": "inventory-by-store-lookup"
      },
      "presentation": {
        "kind": "table",
        "viewDefinitionId": "inventory-list-search-result-viewer"
      }
    },
    {
      "id": "totalCount",
      "label": "照会結果",
      "type": "string",
      "direction": "out"
    }
  ],
  "layout": {
    "version": 1,
    "nodes": [
      {
        "id": "heading",
        "type": "heading",
        "props": {
          "text": "商品検索 / 在庫照会",
          "level": 1
        }
      },
      {
        "id": "searchPanel2",
        "type": "search-panel",
        "props": {
          "columns": 2
        },
        "children": [
          {
            "id": "productCode",
            "type": "field",
            "itemRef": "productCode"
          },
          {
            "id": "storeCode",
            "type": "field",
            "itemRef": "storeCode"
          },
          {
            "id": "buttons",
            "type": "button-bar",
            "children": [
              {
                "id": "clearButton",
                "type": "button",
                "props": {
                  "label": "クリア",
                  "variant": "secondary"
                }
              },
              {
                "id": "searchInventoryButton",
                "type": "button",
                "itemRef": "searchInventoryButton",
                "props": {
                  "label": "在庫照会",
                  "variant": "primary"
                }
              }
            ]
          },
          {
            "id": "text",
            "type": "text",
            "props": {
              "text": "商品コードは P- で始まる 4〜6 桁の番号です。空欄の場合は全商品を表示します。",
              "tone": "muted"
            }
          }
        ]
      },
      {
        "id": "inventoryRows",
        "type": "table",
        "itemRef": "inventoryRows"
      },
      {
        "id": "section",
        "type": "section",
        "props": {
          "variant": "panel"
        },
        "children": [
          {
            "id": "text2",
            "type": "text",
            "props": {
              "text": "照会結果:"
            }
          },
          {
            "id": "totalCount",
            "type": "field",
            "itemRef": "totalCount"
          },
          {
            "id": "text3",
            "type": "text",
            "props": {
              "text": "件"
            }
          },
          {
            "id": "inquiredAt",
            "type": "field",
            "itemRef": "inquiredAt"
          },
          {
            "id": "cartButton",
            "type": "button",
            "props": {
              "label": "カートへ進む",
              "variant": "secondary",
              "screenRef": "cart"
            }
          },
          {
            "id": "text4",
            "type": "text",
            "props": {
              "text": "1 - 10 / 42 件"
            }
          },
          {
            "id": "html",
            "type": "html",
            "props": {
              "html": "<ul class=\"pagination pagination-sm mb-0\">\n              <li class=\"page-item disabled\"><a class=\"page-link\" href=\"#\">«</a></li>\n              <li class=\"page-item active\"><a class=\"page-link\" href=\"#\">1</a></li>\n              <li class=\"page-item\"><a class=\"page-link\" href=\"#\">2</a></li>\n              <li class=\"page-item\"><a class=\"page-link\" href=\"#\">3</a></li>\n              <li class=\"page-item\"><a class=\"page-link\" href=\"#\">4</a></li>\n              <li class=\"page-item\"><a class=\"page-link\" href=\"#\">5</a></li>\n              <li class=\"page-item\"><a class=\"page-link\" href=\"#\">»</a></li>\n            </ul>"
            }
          }
        ]
      },
      {
        "id": "text5",
        "type": "text",
        "props": {
          "text": "在庫あり在庫 11 個以上 / 低在庫在庫 10 個以下 (補充推奨) / 在庫不足在庫 0〜3 個 (注文不可の場合あり)",
          "tone": "muted"
        }
      }
    ]
  }
}
