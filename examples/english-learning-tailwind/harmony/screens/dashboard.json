  "name": "ダッシュボード",
  "description": "学習者のトップ画面。連続学習日数 / 本日の学習目標 / 最近のストーリー / CEFR レベル進捗を一望できるホーム画面。",
  "kind": "dashboard",
  "path": "/",
  "auth": "required",
  "groupId": "learner",
  "maturity": "draft",
  "createdAt": "2026-05-04T00:00:00.000Z",
  "updatedAt": "2026-05-04T00:00:00.000Z",
  "items": [
    {
      "id": "streakDays",
      "label": "連続学習日数",
      "type": "integer",
      "direction": "out",
      "description": "users.streak_days の現在値。連続学習日数バッジとして表示する。"
    },
    {
      "id": "cefrLevel",
      "label": "現在の CEFR レベル",
      "type": "string",
      "direction": "out",
      "description": "users.cefr_level の現在値 (A1/A2/B1/B2/C1/C2)。進捗バーと合わせて表示する。"
    },
    {
      "id": "todayGoal",
      "label": "本日の学習目標 (セッション数)",
      "type": "integer",
      "direction": "out",
      "description": "users.daily_goal_sessions の値。今日の目標セッション数。"
    },
    {
      "id": "todayDone",
      "label": "本日完了セッション数",
      "type": "integer",
      "direction": "out",
      "description": "本日 (JST) に completed となった learning_sessions の件数。"
    },
    {
      "id": "recentStoryList",
      "label": "最近のストーリー",
      "type": "json",
      "direction": "out",
      "description": "直近 3 件の stories (learning_sessions 経由で参照、JSON 配列)。ストーリー一覧への導線として表示する。"
    }
  ],
  "design": {
    "designFileRef": "dashboard.design.json"
  },
