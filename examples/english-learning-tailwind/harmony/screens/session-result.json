      "id": "totalScore",
      "label": "総合発音スコア",
      "type": "number",
      "direction": "out",
      "description": "セッション全ターンの pronunciation_scores.score の平均値。"
    },
    {
      "id": "turnCount",
      "label": "完了ターン数",
      "type": "integer",
      "direction": "out",
      "description": "今回セッションで完了した turn_logs の件数。"
    },
    {
      "id": "newWordsCount",
      "label": "新規習得単語数",
      "type": "integer",
      "direction": "out",
